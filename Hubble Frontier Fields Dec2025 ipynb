xes = axes.ravel()\n","\n","for ax, key in zip(axes, cats_keys):\n","    opt = HFF_OPTIONS[key]\n","    kappa_path = opt[\"kappa\"]\n","    ra_str, dec_str, cluster_label = center_for_key(key)\n","\n","    # profile with your standard finite-difference curvature\n","    prof = profile_with_angular_bins(kappa_path, ra_str, dec_str, opt[\"TAG\"])\n","    R = prof[\"R_arcsec\"]\n","    kappa = prof[\"kappa_mean\"]\n","    d2_fd = prof[\"d2k\"]\n","    R_sh_fd = prof[\"R_sh\"]\n","\n","    # Savitzky–Golay smoothing + curvature\n","    n = len(R)\n","    if n < 5:\n","        # too few points to do anything sensible\n","        d2_sg = np.full_like(d2_fd, np.nan)\n","        R_sh_sg = np.nan\n","    else:\n","        # choose an odd window length, not exceeding n\n","        # aim for ~7 points if possible\n","        wl = 7\n","        if wl > n:\n","            wl = n if n % 2 == 1 else n - 1\n","        if wl < 5:\n","            wl = 5 if n >= 5 else (n if n % 2 == 1 else n - 1)\n","        if wl < 3:\n","            wl = 3\n","\n","        kappa_sg = savgol_filter(kappa, window_length=wl, polyorder=2, mode=\"interp\")\n","        d1_sg = np.gradient(kappa_sg, R)\n","        d2_sg = np.gradient(d1_sg, R)\n","\n","        # shoulder from SG curvature in the same window\n","        mask_win = (R >= SHOULDER_RMIN) & (R <= SHOULDER_RMAX)\n","        if np.any(mask_win):\n","            idx_min = np.argmin(d2_sg[mask_win])\n","            R_sh_sg = float(R[mask_win][idx_min])\n","        else:\n","            R_sh_sg = np.nan\n","\n","    # store summary\n","    results.append(dict(\n","        cluster=cluster_label,\n","        team=\"CATS\",\n","        R_sh_FD=R_sh_fd,\n","        R_sh_SG=R_sh_sg,\n","        delta=R_sh_sg - R_sh_fd\n","    ))\n","\n","    # plot curvature comparison\n","    ax.plot(R, d2_fd, \"-\", label=f\"FD  (R_sh={R_sh_fd:.1f}\\\")\")\n","    ax.plot(R, d2_sg, \"--\", label=f\"SG  (R_sh={R_sh_sg:.1f}\\\")\")\n","\n","    if not np.isnan(R_sh_fd):\n","        ax.axvline(R_sh_fd, color=\"k\", ls=\":\", alpha=0.5)\n","    if not np.isnan(R_sh_sg):\n","        ax.axvline(R_sh_sg, color=\"r\", ls=\"--\", alpha=0.5)\n","\n","    ax.axhline(0, color=\"grey\", lw=0.8)\n","    ax.set_title(f\"{cluster_label} CATS\")\n","    ax.set_xlabel(\"R (arcsec)\")\n","    ax.set_ylabel(\"d²κ/dR²\")\n","\n","    ax.legend(fontsize=8)\n","\n","plt.tight_layout()\n","plt.show()\n","\n","# compact summary table\n","df_sg_cats = pd.DataFrame(results)\n","df_sg_cats\n"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":868},"id":"eIkRn38qfbhM","executionInfo":{"status":"ok","timestamp":1765308107731,"user_tz":0,"elapsed":7488,"user":{"displayName":"Jon Axworthy","userId":"03410905867559825123"}},"outputId":"b0be839d-3d55-45af-b0f4-8d0b59f76b2f"},"execution_count":83,"outputs":[{"output_type":"display_data","data":{"text/plain":["<Figure size 1500x800 with 6 Axes>"],"image/png":"\n"},"metadata":{}},{"output_type":"execute_result","data":{"text/plain":["       cluster  team  R_sh_FD  R_sh_SG  delta\n","0   ABELL 2744  CATS     43.8     22.2  -21.6\n","1    MACS 0416  CATS     43.8     40.2   -3.6\n","2    MACS 0717  CATS     22.2     22.2    0.0\n","3    MACS 1149  CATS     47.4     51.0    3.6\n","4  ABELLS 1063  CATS     76.2     72.6   -3.6\n","5    ABELL 370  CATS     51.0     22.2  -28.8"],"text/html":["\n","  <div id=\"df-d2414e7c-38ec-471a-9317-f2bdcad1860c\" class=\"colab-df-container\">\n","    <div>\n","<style scoped>\n","    .dataframe tbody tr th:only-of-type {\n","        vertical-align: middle;\n","    }\n","\n","    .dataframe tbody tr th {\n","        vertical-align: top;\n","    }\n","\n","    .dataframe thead th {\n","        text-align: right;\n","    }\n","</style>\n","<table border=\"1\" class=\"dataframe\">\n","  <thead>\n","    <tr style=\"text-align: right;\">\n","      <th></th>\n","      <th>cluster</th>\n","      <th>team</th>\n","      <th>R_sh_FD</th>\n","      <th>R_sh_SG</th>\n","      <
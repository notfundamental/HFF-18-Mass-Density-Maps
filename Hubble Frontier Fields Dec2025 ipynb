ion\": \"\"\n      }\n    },\n    {\n      \"column\": \"delta\",\n      \"properties\": {\n        \"dtype\": \"number\",\n        \"std\": 13.029811971014775,\n        \"min\": -28.8,\n        \"max\": 3.5999999999999943,\n        \"num_unique_values\": 6,\n        \"samples\": [\n          -21.599999999999998\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    }\n  ]\n}"}},"metadata":{},"execution_count":83}]},{"cell_type":"code","source":["# Cell: Bootstrap curvature for all 18 HFF κ-maps (diagnostic; SLOW to run)\n","# WARNING: This cell runs n_boot bootstrap realisations for each of the 18 maps.\n","# For n_boot = 500 this can take a noticeable amount of time. Optional diagnostic only.\n","\n","import numpy as np\n","import pandas as pd\n","import matplotlib.pyplot as plt\n","\n","from astropy.io import fits\n","from astropy.wcs import WCS\n","from astropy.coordinates import SkyCoord\n","import astropy.units as u\n","\n","print(\"Bootstrap diagnostic: this may take several minutes for n_boot = 500...\")\n","\n","# Map TAG prefix -> WCS centre (must match your setup cell)\n","CLUSTER_CENTRES = {\n","    \"ABELL2744\":  (CENTER_RA_2744,  CENTER_DEC_2744),\n","    \"MACS0416\":   (CENTER_RA_0416,  CENTER_DEC_0416),\n","    \"MACS0717\":   (CENTER_RA_0717,  CENTER_DEC_0717),\n","    \"MACS1149\":   (CENTER_RA_1149,  CENTER_DEC_1149),\n","    \"ABELLS1063\": (CENTER_RA_S1063, CENTER_DEC_S1063),\n","    \"ABELL370\":   (CENTER_RA_370,   CENTER_DEC_370),\n","}\n","\n","def bootstrap_shoulder_for_map(\n","    kappa_path,\n","    ra_str,\n","    dec_str,\n","    n_boot=500,\n","    random_state=1234,\n","):\n","    \"\"\"\n","    Bootstrap the curvature-minimum radius R_sh for a single κ-map.\n","\n","    Returns a dict with:\n","      'R_arc'           : bin centres (arcsec)\n","      'kappa_mean'      : fiducial κ(R)\n","      'R_sh_fid'        : fiducial shoulder radius (arcsec)\n","      'R_sh_boot'       : array of bootstrap R_sh values (arcsec, may include NaN)\n","      'R_sh_boot_clean' : finite subset of R_sh_boot\n","    \"\"\"\n","    # --- load map and WCS ---\n","    with fits.open(kappa_path) as hdul:\n","        data = hdul[0].data\n","        hdr  = hdul[0].header\n","\n","    w = WCS(hdr)\n","    pixscale = pixel_scale_arcsec(hdr)\n","\n","    # --- centre in pixels from WCS ---\n","    coord_c = SkyCoord(ra_str, dec_str, unit=(u.hourangle, u.deg))\n","    cx, cy = w.all_world2pix([[coord_c.ra.deg, coord_c.dec.deg]], 0)[0]\n","    cx, cy = float(cx), float(cy)\n","\n","    ny, nx = data.shape\n","    yy, xx = np.indices(data.shape)\n","    r_pix = np.sqrt((xx - cx)**2 + (yy - cy)**2)\n","\n","    # --- masks ---\n","    valid = np.ones_like(data, dtype=bool)\n","    if MASK_NAN:\n","        valid &= ~np.isnan(data)\n","    if MASK_ZERO:\n","        valid &= (data != 0.0)\n","\n","    # --- angular bins (same as profile_with_angular_bins) ---\n","    if BIN_SPACING == \"linear\":\n","        edges_arc = np.linspace(ANG_R_INNER, ANG_R_OUTER, N_BINS + 1)\n","    else:\n","        edges_arc = np.logspace(np.log10(ANG_R_INNER), np.log10(ANG_R_OUTER), N_BINS + 1)\n","    edges_pix = edges_arc / pixscale\n","    mids_arc  = 0.5 * (edges_arc[:-1] + edges_arc[1:])\n","\n","    # --- collect per-bin pixel values for usable bins ---\n","    bin_R_arc = []\n","    bin_vals  = []\n","\n","    for (rmin_pix, rmax_pix, rmid_arc) in zip(edges_pix[:-1], edges_pix[1:], mids_arc):\n","        ann = (r_pix >= rmin_pix) & (r_pix < rmax_pix)\n","        tot = ann.sum()\n","        if tot == 0:\n","            continue\n","        good = ann & valid\n","        N_valid = good.sum()\n","        if N_valid == 0:\n","            continue\n","        vals = data[good]\n","        vfrac = N_valid / tot\n","        if vfrac >= MIN_VALID_FRACTION:\n","            bin_R_arc.append(rmid_arc)\n","            bin_vals.append(vals.astype(float))\n","\n","    bin_R_arc = np.asarray(bin_R_arc)\n","    if len(bin_R_arc) < 3:\n","        raise RuntimeError(\"Not enough usable bins for curvature estimate.\")\n","\n","    # --- fiducial κ(R) and R_sh ---\n","    kappa_mean = np.array([v.mean() for v in bin_vals])\n","    dk  = np.gradient(kappa_mean, bin_R_arc)\n","    d2k = np.gradient(dk,          bin_R_arc)\n","\n","    mask_win = (bin_R_arc >= SHOULDER_RMIN) & (bin_R_arc <= SHOULDER_RMAX)\n","    Rw = bin_R_arc[mask_win]\n","    cw = d2k[mask_win]\n","    if len(Rw) >= 3:\n","        idx = np.argmin(cw)\n","        R_sh_fid = float(Rw[idx])\n","    else:\n","        R_sh_fid = np.nan\n","\n","    # --- bootstrap realisations ---\n","    rng = np.random.default_rng(random_state)\n","    R_sh_boot = []\n","\n","    for _ in range(n_boot):\n","        # resample each bin with replacement\n","        kappa_boot = []\n","        for vals in bin_vals:\n","            n = len(vals)\n","            if n == 0:\n","                kappa_boot.append(np.nan)\n","                continue\n","            draw = rng.choice(vals, size=n, replace=True)\n","            kappa_boot.append(draw.mean())\n","        kappa_boot = np.asarray(kappa_boot)\n","\n","        # curvature and shoulder for this realisation\n","        dk_b  = np.gradient(kappa_boot, bin_R_arc)\n","        d2k_b = np.gradient(dk_b,      bin_R_arc)\n","\n","        Rw_b = bin_R_arc[mask_win]\n","        cw_b = d2k_b[mask_win]\n","        if len(Rw_b) >= 3 and np.isfinite(cw_b).sum() >= 3:\n","            idx_b = np.argmin(cw_b)\n","            R_sh_boot.append(float(Rw_b[idx_b]))\n","        else:\n","            R_sh_boot.append(np.nan)\n","\n","    R_sh_boot = np.asarray(R_sh_boot)\n","    R_sh_boot_clean = R_sh_boot[np.isfinite(R_sh_boot)]\n","\n","    return dict(\n","        R_arc=bin_R_arc,\n","        kappa_mean=kappa_mean,\n","        R_sh_fid=R_sh_fid,\n","        R_sh_boot=R_sh_boot,\n","        R_sh_boot_clean=R_sh_boot_clean,\n","    )\n","\n","def run_bootstrap_for_all_maps(n_boot=500, base_seed=1234):\n","    \"\"\"\n","    Run bootstrap curvature-minimum test for all 18 HFF maps.\n","\n","    Returns:\n","        df_summary : pandas DataFrame with one row per map\n","        boot_dict  : dict TAG -> bootstrap result dict\n","    \"\"\"\n","    rows = []\n","    boot_dict = {}\n","\n","    for key in sorted(HFF_OPTIONS.keys()):\n","        opt = HFF_OPTIONS[key]\n","        tag = opt[\"TAG\"]          # e.g. \"ABELL2744_CATS\"\n","        cluster_token = tag.split(\"_\")[0]  # e.g. \"ABELL2744\"\n","        team_token    = tag.split(\"_\")[1]  # e.g. \"CATS\"\n","\n","        if cluster_token not in CLUSTER_CENTRES:\n","            raise KeyError(f\"No centre defined for cluster token '{cluster_token}'\")\n","\n","        ra_str, dec_str = CLUSTER_CENTRES[cluster_token]\n","\n","        print(f\"Running bootstrap for {tag} ...\")\n","        res = bootstrap_shoulder_for_map(\n","            opt[\"kappa\"],\n","            ra_str,\n","            dec_str,\n","            n_boot=n_boot,\n","            random_state=base_seed + key,\n","        )\n","        boot_dict[tag] = res\n","\n","        Rfid = res[\"R_sh_fid\"]\n","        Rb   = res[\"R_sh_boot_clean\"]\n","        if len(Rb) > 0:\n","            mean_R = np.mean(Rb)\n","            std_R  = np.std(Rb, ddof=1)\n","            p16, p50, p84 = np.percentile(Rb, [16, 50, 84])\n","        else:\n","            mean_R = std_R = p16 = p50 = p84 = np.nan\n","\n","        rows.append(dict(\n","            tag        = tag,\n","            cluster    = cluster_token,\n","            team       = team_token,\n","            n_boot_eff = len(Rb),\n","            R_sh_fid   = Rfid,\n","            R_sh_mean  = mean_R,\n","            R_sh_std   = std_R,\n","            R_sh_p16   = p16,\n","            R_sh_p50   = p50,\n","            R_sh_p84   = p84,\n","        ))\n","\n","    df_summary = (\n","        pd.DataFrame(rows)\n","        .sort_values([\"cluster\", \"team\"])\n","        .reset_index(drop=True)\n","    )\n","    return df_summary, boot_dict\n","\n","# --------------------------------------------------------------------\n","# Run for all 18 maps (change n_boot if you want a quicker diagnostic)\n","# --------------------------------------------------------------------\n","df_bootstrap_summary, BOOTSTRAP_RESULTS = run_bootstrap_for_all_maps(n_boot=500)\n","\n","display(df_bootstrap_summary)\n","# Optional: save to CSV for later inspection\n","# df_bootstrap_summary.to_csv(\"HFF_bootstrap_Rsh_summary.csv\", index=False)\n"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":943},"id":"JVa-ZSzJlo_-","executionInfo":{"status":"ok","timestamp":1765311872927,"user_tz":0,"elapsed":3335758,"user":{"displayName":"Jon Axworthy","userId":"03410905867559825123"}},"outputId":"092029f1-1694-4ad0-ac1c-04fdb98a915c"},"execution_count":85,"outputs":[{"output_type":"stream","name":"stdout","text":["Bootstrap diagnostic: this may take several minutes for n_boot = 500...\n","Running bootstrap for ABELL2744_CATS ...\n","Running bootstrap for ABELL2744_GLAFIC ...\n","Running bootstrap for ABELL2744_SHARON ...\n","Running bootstrap for MACS0416_CATS ...\n","Running bootstrap for MACS0416_SHARON ...\n","Running bootstrap for MACS0416_GLAFIC ...\n","Running bootstrap for MACS0717_CATS ...\n","Running bootstrap for MACS0717_GLAFIC ...\n","Running bootstrap for MACS0717_SHARON ...\n","Running bootstrap for MACS1149_CATS ...\n","Running bootstrap for MACS1149_SHARON ...\n","Running bootstrap for MACS1149_GLAFIC ...\n","Running bootstrap for ABELLS1063_CATS ...\n","Running bootstrap for ABELLS1063_GLAFIC ...\n","Running bootstrap for ABELLS1063_SHARON ...\n","Running bootstrap for ABELL370_CATS ...\n","Running bootstrap for ABELL370_GLAFIC ...\n","Running bootstrap for ABELL370_SHARON ...\n"]},{"output_type":"display_data","data":{"text/plain":["                  tag     cluster    team  n_boot_eff  R_sh_fid  R_sh_mean  \\\n","0      ABELL2744_CATS   ABELL2744    CATS         500     
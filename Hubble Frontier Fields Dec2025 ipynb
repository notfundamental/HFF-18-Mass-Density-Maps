ype\": \"number\",\n        \"std\": 2986,\n        \"min\": 89,\n        \"max\": 10748,\n        \"num_unique_values\": 100,\n        \"samples\": [\n          7516,\n          3174,\n          1154\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    },\n    {\n      \"column\": \"R_sh_arcsec\",\n      \"properties\": {\n        \"dtype\": \"number\",\n        \"std\": null,\n        \"min\": null,\n        \"max\": null,\n        \"num_unique_values\": 0,\n        \"samples\": [],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    }\n  ]\n}"}},"metadata":{},"execution_count":81}]},{"cell_type":"code","source":["# Cell: Cluster ensemble vs Parallel-field null — Normalised Shoulder Radii\n","# -------------------------------------------------------------------------\n","\n","import numpy as np\n","import matplotlib.pyplot as plt\n","\n","# ------------------------------\n","# 1. Normalised R_sh for clusters\n","# ------------------------------\n","\n","cluster_norm = []\n","\n","for _, row in results_df.iterrows():\n","    cluster = row[\"cluster\"]\n","    team    = row[\"team\"]\n","    R_sh    = float(row[\"R_sh_arcsec\"])\n","\n","    # RA/DEC centre taken directly from results_df (no CENTRES dict needed)\n","    ra_str  = row[\"RA_center\"]\n","    dec_str = row[\"DEC_center\"]\n","\n","    # find map\n","    opt = next(v for v in HFF_OPTIONS.values() if v[\"TAG\"] == team)\n","    kappa_path = opt[\"kappa\"]\n","\n","    # recompute radial profile to get r_max for this map\n","    prof = profile_with_angular_bins(kappa_path, ra_str, dec_str, team)\n","    R_arc = np.asarray(prof[\"R_arcsec\"])\n","    R_arc = R_arc[np.isfinite(R_arc)]\n","\n","    if len(R_arc) == 0:\n","        continue\n","\n","    r_max = R_arc.max()\n","    r_norm = R_sh / r_max\n","    cluster_norm.append(r_norm)\n","\n","cluster_norm = np.array(cluster_norm)\n","\n","# ----------------------------------------\n","# 2. Normalised R_sh for parallel null test\n","# ----------------------------------------\n","\n","# df_null must contain R_sh_arcsec from run_parallel_random_null_test()\n","R_MAX_ARC = 120.0  # your null-test max radius\n","\n","null_norm = df_null[\"R_sh_arcsec\"].values / R_MAX_ARC\n","\n","# ------------------------------\n","# 3. Plot comparison\n","# ------------------------------\n","\n","plt.figure(figsize=(7, 5))\n","\n","bins = np.linspace(0, 1.0, 20)\n","\n","plt.hist(null_norm,    bins=bins, alpha=0.6, label=\"Parallel-field null\",      color=\"C1\")\n","plt.hist(cluster_norm, bins=bins, alpha=0.6, label=\"HFF clusters (18 maps)\",   color=\"C0\")\n","\n","plt.axvline(np.median(null_norm),    color=\"C1\", ls=\"--\", lw=1.2,\n","            label=f\"Null median = {np.median(null_norm):.2f}\")\n","plt.axvline(np.median(cluster_norm), color=\"C0\", ls=\"--\", lw=1.2,\n","            label=f\"Cluster median = {np.median(cluster_norm):.2f}\")\n","\n","plt.xlabel(r\"Normalised shoulder radius  $r_{\\rm sh}/r_{\\max}$\")\n","plt.ylabel(\"Count\")\n","plt.title(\"Cluster ensemble vs Parallel-field null (normalised shoulder radii)\")\n","plt.legend()\n","plt.grid(alpha=0.3)\n","\n","plt.tight_layout()\n","plt.show()\n","\n","# Print detailed stats\n","print(\"Cluster shoulders (normalised):\")\n","print(f\"  N = {len(cluster_norm)}\")\n","print(f\"  median = {np.median(cluster_norm):.3f}\")\n","print(f\"  range  = {cluster_norm.min():.3f} – {cluster_norm.max():.3f}\")\n","\n","print(\"\\nParallel null shoulders (normalised):\")\n","print(f\"  N = {len(null_norm)}\")\n","print(f\"  median = {np.median(null_norm):.3f}\")\n","print(f\"  range  = {null_norm.min():.3f} – {null_norm.max():.3f}\")\n"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":663},"id":"W16ouTsUK5e9","executionInfo":{"status":"ok","timestamp":1765301596841,"user_tz":0,"elapsed":70027,"user":{"displayName":"Jon Axworthy","userId":"03410905867559825123"}},"outputId":"1202ff0a-2b9f-453d-c6e8-0756b8862f0a"},"execution_count":73,"outputs":[{"output_type":"display_data","data":{"text/plain":["<Figure size 700x500 with 1 Axes>"],"image/png":"\n"},"metadata":{}},{"output_type":"stream","name":"stdout","text":["Cluster shoulders (normalised):\n","  N = 18\n","  median = 0.324\n","  range  = 0.150 – 0.602\n","\n","Parallel null shoulders (normalised):\n","  N = 20\n","  median = 0.412\n","  range  = 0.188 – 0.637\n"]}]},{"cell_type":"code","source":["# Cell: Generic centre-robustness test for any HFF cluster\n","# --------------------------------------------------------\n","# Usage example (uncomment one at the end of the cell to run):\n","#df_abell2744_center_robustness = run_center_robustness(\"ABELL2744\", offsets_range=3)\n","\n","\n","\n","import numpy as np\n","import pandas as pd\n","from astropy.io import fits\n","from astropy.wcs import WCS\n","from astropy.coordinates import SkyCoord\n","import astropy.units as u\n","\n","# Helper: shift the cluster centre by (dx, dy) pixels using the map WCS\n","def _shifted_center_strings(kappa_path, ra_str, dec_str, dx_pix, dy_pix):\n","    \"\"\"\n","    Given a kappa FITS path and a centre (RA, Dec) as strings,\n","    return new (RA, Dec) strings corresponding to a pixel shift (dx_pix, dy_pix)\n","    in the image frame.\n","    \"\"\"\n","    with fits.open(kappa_path) as hdul:\n","        hdr = hdul[0].header\n","    w = WCS(hdr)\n","\n","    c = SkyCoord(ra_str, dec_str, unit=(u.hourangle, u.deg))\n","    x0, y0 = w.world_to_pixel(c)\n","    x1, y1 = x0 + dx_pix, y0 + dy_pix\n","    c1 = w.pixel_to_world(x1, y1)\n","\n","    ra_new = c1.ra.to_string(unit=u.hourangle, sep=\":\", pad=True, precision=3)\n","    dec_new = c1.dec.to_string(unit=u.deg,      sep=\":\", alwayssign=True, precision=2)\n","    return ra_new, dec_new\n","\n","def run_center_robustness(cluster_name, offsets_range=3):\n","    \"\"\"\n","    Centre robustness test for one HFF cluster.\n","\n","    Parameters\n","    ----------\n","    cluster_name : str\n","        Name in results_df['cluster'], e.g. \"ABELL2744\", \"MACS0416\".\n","    offsets_range : int\n","        Test pixel offsets dx,dy in [-offsets_range, ..., +offsets_range].\n","\n","    Returns\n","    -------\n","    df_cluster : pandas.DataFrame\n","        Table of R_sh and ΔR_sh for each (team, dx, dy).\n","    \"\"\"\n","    # subset of final shoulders table for this cluster\n","    sub = results_df[results_df[\"cluster\"] == cluster_name].copy()\n","    if sub.empty:\n","        raise ValueError(f\"No entries for cluster '{cluster_name}' in results_df\")\n","\n","    # map TAG -> kappa path\n","    tag_to_kappa = {opt[\"TAG\"]: opt[\"kappa\"] for opt in HFF_OPTIONS.values()}\n","\n","    # pixel offsets grid\n","    offsets = [\n","        (dx, dy)\n","        for dx in range(-offsets_range, offsets_range + 1)\n","        for dy in range(-offsets_range, offsets_range + 1)\n","    ]\n","\n","    rows = []\n","\n","    for team in sorted(sub[\"team\"].unique()):\n","        row0 = sub[sub[\"team\"] == team].iloc[0]\n","        ra0  = row0[\"RA_center\"]\n","        dec0 = row0[\"DEC_center\"]\n","        R_sh_fid = float(row0[\"R_sh_arcsec\"])\n","\n","        kappa_path = tag_to_kappa[team]\n","\n","        print(f\"\\nProcessing {cluster_name} {team} (fiducial R_sh = {R_sh_fid:.3f}\\\")\")\n","\n","        for dx_pix, dy_pix in offsets:\n","            # (0,0): use fiducial centre; others: shifted\n","            if dx_pix == 0 and dy_pix == 0:\n","                ra_use, dec_use = ra0, dec0\n","            else:\n","                ra_use, dec_use = _shifted_center_strings(\n","                    kappa_path, ra0, dec0, dx_pix, dy_pix\n","                )\n","\n","            prof = profile_with_angular_bins(\n","                kappa_path,\n","                ra_use,\n","                dec_use,\n","                f\"{cluster_name}_{team}_dx{dx_pix}_dy{dy_pix}\",\n","            )\n","\n","            R_sh = float(prof[\"R_sh\"]) if not np.isnan(prof[\"R_sh\"]) else np.nan\n","\n","            rows.append(\n","                dict(\n","                    cluster=cluster_name,\n","                    team=team,\n","                    dx_pix=dx_pix,\n","                    dy_pix=dy_pix,\n","                    R_sh_arcsec=R_sh,\n","                    delta_R_sh_arcsec=R_sh - R_sh_fid if not np.isnan(R_sh) else np.nan,\n","                )\n","            )\n","\n","    df_cluster = pd.DataFrame(rows)\n","\n","    print(f\"\\n{cluster_name} centre robustness — max |ΔR_sh| per team (arcsec):\")\n","    print(\n","        df_cluster.groupby(\"team\")[\"delta_R_sh_arcsec\"]\n","        .apply(lambda s: np.nanmax(np.abs(s)))\n","    )\n","\n","    outname = f\"{cluster_name}_center_robustness_offsets.csv\"\n","    df_cluster.to_csv(outname, index=False)\n","    print(f\"Saved: {outname}\")\n","\n","    return df_cluster\n","\n","# Example (commented):\n","# df_abell2744_center_robustness = run_center_robustness(\"ABELL2744\", offsets_range=3)\n","# df_macs0416_center_robustness  = run_center_robustness(\"MACS0416\",  offsets_range=3)\n","# df_macs0717_center_robustness  = run_center_robustness(\"MACS0717\",  offsets_range=3)\n","# df_macs1149_center_robustness  = run_center_robustness(\"MACS1149\",  offsets_range=3)\n","# df_s1063_center_robustness     = run_center_robustness(\"ABELLS1063\", offsets_range=3)\n","# df_a370_center_robustness      = run_center_robustness(\"ABELL370\",  offsets_range=3)\n"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"8oJ0pBhKQCex","executionInfo":{"status":"ok","timestamp":1765303617203,"user_tz":0,"elapsed":587843,"user":{"displayName":"Jon Axworthy","userId":"03410905867559825123"}},"outputId":"3285e669-a715-43e9-e490-b493d9769afe"},"execution_count":76,"outputs":[{"output_type":"stream","name":"stdout","text":["\n","Processing MACS0416 MACS0416_CATS (fiducial R_sh = 43.800\")\n","\n","Processing MACS0416 MACS0416_GLAFIC (fiducial R_sh = 36.600\")\n","\n","Processing MACS0416 MACS0416_SHARON (fiducial R_sh = 40.200\")\n","\n","MACS0416 centre robustness — max |ΔR_sh| per team (arcsec):\n","team\n","MACS0416_CATS      7.200000e+00\n","MACS0416_GLAFIC    7.105427e-15\n","MACS0416_SHARON    0.000000e+00\n","Name: delta_R_sh_arcsec, dtype: float64\n","Saved: MACS0416_center_robustness_offsets.csv\n"]}]},{"cell_type":"code","source":["# Cell: κ(R) and d²κ/dR² for selected centre offsets (generic HFF utility)\n","# -----------------------------------------------------------------------\n","# Usage example (reproduces your MACS 0717 CATS plot):\n","# plot_center_offset_profiles(\"MACS0717\", \"MACS0717_CATS\")\n","\n","import numpy as np\n","import matplotlib.pyplot as plt\n","from astropy.io import fits\n","from astropy.wcs import WCS\n","from astropy.coordinates import SkyCoord\n","import astropy.units as u\n","\n","def _shift_center_ra_dec(kappa_path, ra_str, dec_str, dx_pix, dy_pix):\n","    \"\"\"\n","    Shift a centre (RA, Dec) by (dx_pix, dy_pix) in pixel space for a given map.\n","    Returns new (RA, Dec) strings.\n","    \"\"\"\n","    with fits.open(kappa_path) as hdul:\n","        hdr = hdul[0].header\n","    w = WCS(hdr)\n","\n","    c0 = SkyCoord(ra_str, dec_str, unit=(u.hourangle, u.deg))\n","    x0, y0 = w.world_to_pixel(c0)\n","    x1, y1 = x0 + dx_pix, y0 + dy_pix\n","    c1 = w.pixel_to_world(x1, y1)\n","\n","    ra_new = c1.ra.to_string(unit=u.hourangle, sep=\":\", pad=True, precision=3)\n","    dec_new = c1.dec.to_string(unit=u.deg,      sep=\":\", alwayssign=True, precision=2)\n","    return ra_new, dec_new\n","\n","def plot_center_offset_profiles(cluster_name, team_tag, offsets=None):\n","    \"\"\"\n","    Plot κ(R) and d²κ/dR² for one HFF reconstruction (cluster_name, team_tag)\n","    at a set of pixel-centre offsets.\n","\n","    Parameters\n","    ----------\n","    cluster_name : str\n","        e.g. \"MACS0717\", \"ABELL2744\", \"ABELLS1063\".\n","    team_tag : str\n","        Exact TAG used in HFF_OPTIONS, e.g. \"MACS0717_CATS\".\n","    offsets : list of (dx, dy, label) tuples, optional\n","        Pixel offsets to examine. If None, a default set is used.\n","    \"\"\"\n","    # default offsets: fiducial + a few diagonals\n","    if offsets is None:\n","        offsets = [\n","            (0, 0,   \"dx=0, dy=0 (fiducial)\"),\n","            (-1, -1, \"dx=-1, dy=-1\"),\n","            (1, -1,  \"dx=+1, dy=-1\"),\n","            (-3, -3, \"dx=-3, dy=-3\"),\n","        ]\n","\n","    # get kappa path\n","    opt = next(v for v in HFF_OPTIONS.values() if v[\"TAG\"] == team_tag)\n","    kappa_path = opt[\"kappa\"]\n","\n","    # get fiducial centre from results_df\n","    row0 = results_df[(results_df[\"cluster\"] == cluster_name) &\n","                      (results_df[\"team\"] == team_tag)].iloc[0]\n","    ra0  = row0[\"RA_center\"]\n","    dec0 = row0[\"DEC_center\"]\n","\n","    profiles = []\n","\n","    for dx, dy, label in offsets:\n","        if dx == 0 and dy == 0:\n","            ra_use, dec_use = ra0, dec0\n","        else:\n","            ra_use, dec_use = _shift_center_ra_dec(kappa_path, ra0, dec0, dx, dy)\n","\n","        prof = profile_with_angular_bins(\n","            kappa_path,\n","            ra_use,\n","            dec_use,\n","            f\"{cluster_name}_{team_tag}_dx{dx}_dy{dy}\",\n","        )\n","        profiles.append((dx, dy, label, prof))\n","\n","    # --- plotting ---\n","    fig, axes = plt.subplots(1, 2, figsize=(14, 5), sharex=True)\n","    ax_k, ax_c = axes\n","\n","    for dx, dy, label, prof in profiles:\n","        R = np.asarray(prof[\"R_arcsec\"])\n","        k = np.asarray(prof[\"kappa_mean\"])\n","        c2 = np.asarray(prof[\"d2k\"])\n","        R_sh = float(prof[\"R_sh\"])\n","\n","        mask = np.isfinite(R) & np.isfinite(k) & np.isfinite(c2)\n","        R = R[mask]\n","        k = k[mask]\n","        c2 = c2[mask]\n","\n","        style = \"-\" if (dx, dy) == (0, 0) else \"--\"\n","\n","        ax_k.plot(R, k, style, label=f\"{label}, R_sh≈{R_sh:.1f}\\\"\")\n","        ax_c.plot(R, c2, style, label=f\"{label}, R_sh≈{R_sh:.1f}\\\"\")\n","\n","        if not np.isnan(R_sh):\n","            ax_c.axvline(R_sh, ls=\":\", alpha=0.6)\n","\n","    ax_k.set_xlabel(r\"$R\\ {\\rm (arcsec)}$\")\n","    ax_k.set_ylabel(r\"$\\langle \\kappa \\rangle(R)$\")\n","    ax_k.set_title(f\"{cluster_name} {team_tag.split('_')[-1]}: κ(R) for selected offsets\")\n","    ax_k.legend(fontsize=8)\n","\n","    ax_c.axhline(0, color=\"k\", lw=1)\n","    ax_c.set_xlabel(r\"$R\\ {\\rm (arcsec)}$\")\n","    ax_c.set_ylabel(r\"$d^2\\kappa/dR^2$\")\n","    ax_c.set_title(f\"{cluster_name} {team_tag.split('_')[-1]}: curvature for selected offsets\")\n","    ax_c.legend(fontsize=8)\n","\n","    plt.tight_layout()\n","    plt.show()\n","\n","# CATS — centre-offset curvature diagnostics\n","# plot_center_offset_profiles(\"ABELL2744\",  \"ABELL2744_CATS\")\n","# plot_center_offset_profiles(\"MACS0416\",   \"MACS0416_CATS\")\n","# plot_center_offset_profiles(\"MACS0717\",   \"MACS0717_CATS\")\n","# plot_center_offset_profiles(\"MACS1149\",   \"MACS1149_CATS\")\n","# plot_center_offset_profiles(\"ABELLS1063\", \"ABELLS1063_CATS\")\n","# plot_center_offset_profiles(\"ABELL370\",   \"ABELL370_CATS\")\n","\n","# GLAFIC — centre-offset curvature diagnostics\n","# plot_center_offset_profiles(\"ABELL2744\",  \"ABELL2744_GLAFIC\")\n","# plot_center_offset_profiles(\"MACS0416\",   \"MACS0416_GLAFIC\")\n","# plot_center_offset_profiles(\"MACS0717\",   \"MACS0717_GLAFIC\")\n","# plot_center_offset_profiles(\"MACS1149\",   \"MACS1149_GLAFIC\")\n","# plot_center_offset_profiles(\"ABELLS1063\",\"ABELLS1063_GLAFIC\")\n","# plot_center_offset_profiles(\"ABELL370\",  \"ABELL370_GLAFIC\")\n","\n","# SHARON — centre-offset curvature diagnostics\n","# plot_center_offset_profiles(\"ABELL2744\",  \"ABELL2744_SHARON\")\n","# plot_center_offset_profiles(\"MACS0416\",   \"MACS0416_SHARON\")\n","# plot_center_offset_profiles(\"MACS0717\",   \"MACS0717_SHARON\")\n","# plot_center_offset_profiles(\"MACS1149\",   \"MACS1149_SHARON\")\n","# plot_center_offset_profiles(\"ABELLS1063\",\"ABELLS1063_SHARON\")\n","# plot_center_offset_profiles(\"ABELL370\",  \"ABELL370_SHARON\")\n","\n","\n","\n"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":436},"id":"877n8ekzWbvE","executionInfo":{"status":"ok","timestamp":1765304943543,"user_tz":0,"elapsed":15554,"user":{"displayName":"Jon Axworthy","userId":"03410905867559825123"}},"outputId":"a5f9f4a0-1f86-4cc7-a654-9e4c2f76f618"},"execution_count":79,"outputs":[{"output_type":"display_data","data":{"text/plain":["<Figure size 1400x500 with 2 Axes>"],"image/png":"\n"},"metadata":{}}]},{"cell_type":"code","source":["# ONE CELL: Binning robustness for all 18 HFF κ maps (CATS / GLAFIC / SHARON)\n","\n","import numpy as np\n","import pandas as pd\n","\n","# --- binning variants to test (all linear, same ANG_R_INNER/OUTER & window) ---\n","BIN_VARIANTS = [30, 40, 50]  # 40 is the current baseline\n","\n","# keep originals to restore at end\n","N_BINS_orig      = N_BINS\n","BIN_SPACING_orig = BIN_SPACING\n","\n","def center_for_key(key):\n","    \"\"\"Return (RA, DEC) strings for a given HFF_OPTIONS key (1..18).\"\"\"\n","    if key in (1, 2, 3):      # ABELL 2744\n","        return CENTER_RA_2744, CENTER_DEC_2744\n","    elif key in (4, 5, 6):    # MACS 0416\n","        return CENTER_RA_0416, CENTER_DEC_0416\n","    elif key in (7, 8, 9):    # MACS 0717\n","        return CENTER_RA_0717, CENTER_DEC_0717\n","    elif key in (10, 11, 12): # MACS 1149\n","        return CENTER_RA_1149, CENTER_DEC_1149\n","    elif key in (13, 14, 15): # ABELLS 1063\n","        return CENTER_RA_S1063, CENTER_DEC_S1063\n","    elif key in (16, 17, 18): # ABELL 370\n","        return CENTER_RA_370, CENTER_DEC_370\n","    else:\n","        raise ValueError(f\"Unexpected HFF_OPTIONS key: {key}\")\n","\n","rows = []\n","\n","for key, opt in HFF_OPTIONS.items():\n","    kappa_path = opt[\"kappa\"]\n","    tag        = opt[\"TAG\"]          # e.g. \"ABELL2744_CATS\"\n","    cluster    = tag.split(\"_\")[0]   # \"ABELL2744\"\n","    team       = tag.split(\"_\")[1]   # \"CATS\", \"GLAFIC\", \"SHARON\"\n","    ra_str, dec_str = center_for_key(key)\n","\n","    print(f\"\\nProcessing {cluster} {team} (HFF key={key})\")\n","\n","    for nb in BIN_VARIANTS:\n","        # override global binning config for this call\n","        N_BINS      = nb\n","        BIN_SPACING = \"linear\"\n","\n","        prof = profile_with_angular_bins(\n","            kappa_path,\n","            ra_str,\n","            dec_str,\n","            f\"{cluster}_{team}_NB{nb}\"\n","        )\n","\n","        rows.append(\n","            dict(\n","                key=key,\n","                cluster=cluster,\n","                team=team,\n","                N_bins=nb,\n","                R_sh_arcsec=float(prof[\"R_sh\"]) if not np.isnan(prof[\"R_sh\"]) else np.nan,\n","            )\n","        )\n","\n","# restore original globals\n","N_BINS      = N_BINS_orig\n","BIN_SPACING = BIN_SPACING_orig\n","\n","df_bin_robust = pd.DataFrame(rows)\n","\n","# compute baseline R_sh for N_bins=40 and deltas for each variant\n","baseline = (\n","    df_bin_robust[df_bin_robust[\"N_bins\"] == 40]\n","    .set_index([\"cluster\", \"team\"])[\"R_sh_arcsec\"]\n","    .rename(\"R_sh_baseline\")\n",")\n","\n","df_bin_robust = df_bin_robust.set_index([\"cluster\", \"team\"])\n","df_bin_robust = df_bin_robust.join(baseline, on=[\"cluster\", \"team\"])\n","df_bin_robust[\"delta_R_sh_arcsec\"] = df_bin_robust[\"R_sh_arcsec\"] - df_bin_robust[\"R_sh_baseline\"]\n","\n","# summary: max |ΔR_sh| per cluster/team over all bin variants\n","summary = (\n","    df_bin_robust\n","    .groupby(level=[\"cluster\", \"team\"])[\"delta_R_sh_arcsec\"]\n","    .apply(lambda s: np.nanmax(np.abs(s)))\n","    .rename(\"max_abs_delta_R_sh_arcsec\")\n",")\n","\n","print(\"\\nBinning robustness — max |ΔR_sh| (arcsec) over N_bins = 30,40,50:\")\n","print(summary)\n","\n","# reset index for easier inspection in notebook\n","df_bin_robust = df_bin_robust.reset_index()\n","df_bin_robust.head()\n"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":1000},"id":"pFfH62Zgdqyn","executionInfo":{"status":"ok","timestamp":1765308064490,"user_tz":0,"elapsed":271938,"user":{"displayName":"Jon Axworthy","userId":"03410905867559825123"}},"outputId":"702654b1-c8a7-459d-96e4-bd8aaf8f5a44"},"execution_count":82,"outputs":[{"output_type":"stream","name":"stdout","text":["\n","Processing ABELL2744 CATS (HFF key=1)\n","\n","Processing ABELL2744 GLAFIC (HFF key=2)\n","\n","Processing ABELL2744 SHARON (HFF key=3)\n","\n","Processing MACS0416 CATS (HFF key=4)\n","\n","Processing MACS0416 SHARON (HFF key=5)\n","\n","Processing MACS0416 GLAFIC (HFF key=6)\n","\n","Processing MACS0717 CATS (HFF key=7)\n","\n","Processing MACS0717 GLAFIC (HFF key=8)\n","\n","Processing MACS0717 SHARON (HFF key=9)\n","\n","Processing MACS1149 CATS (HFF key=10)\n","\n","Processing MACS1149 SHARON (HFF key=11)\n","\n","Processing MACS1149 GLAFIC (HFF key=12)\n","\n","Processing ABELLS1063 CATS (HFF key=13)\n","\n","Processing ABELLS1063 GLAFIC (HFF key=14)\n","\n","Processing ABELLS1063 SHARON (HFF key=15)\n","\n","Processing ABELL370 CATS (HFF key=16)\n","\n","Processing ABELL370 GLAFIC (HFF key=17)\n","\n","Processing ABELL370 SHARON (HFF key=18)\n","\n","Binning robustness — max |ΔR_sh| (arcsec) over N_bins = 20,30,40,60:\n","cluster     team  \n","ABELL2744   CATS      19.8\n","            GLAFIC    27.0\n","            SHARON    34.2\n","ABELL370    CATS      27.0\n","            GLAFIC    30.6\n","            SHARON    23.4\n","ABELLS1063  CATS       1.8\n","            GLAFIC     1.8\n","            SHARON    54.6\n","MACS0416    CATS       5.4\n","            GLAFIC     6.6\n","            SHARON     3.0\n","MACS0717    CATS       1.8\n","            GLAFIC     1.8\n","   
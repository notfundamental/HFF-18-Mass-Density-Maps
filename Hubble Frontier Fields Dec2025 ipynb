          51.0\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    }\n  ]\n}"}},"metadata":{}}]},{"cell_type":"markdown","source":["#Noise Injection"],"metadata":{"id":"yif3fRHNu4mK"}},{"cell_type":"code","source":["# Cell: Noise–injection curvature test for all 18 HFF κ-maps (diagnostic; SLOW)\n","# WARNING: This cell runs n_real noisy realisations for each of the 18 maps and\n","# for each noise level. With n_real = 200 and 3 sigma levels this is heavy.\n","# Optional robustness diagnostic; not required for reproducing the main result.\n","\n","import numpy as np\n","import pandas as pd\n","\n","from astropy.io import fits\n","from astropy.wcs import WCS\n","from astropy.coordinates import SkyCoord\n","import astropy.units as u\n","\n","print(\"Noise-injection diagnostic: this may take a long time for n_real = 200 ...\")\n","\n","# Cluster TAG prefix -> WCS centre (must match setup cell)\n","CLUSTER_CENTRES = {\n","    \"ABELL2744\":  (CENTER_RA_2744,  CENTER_DEC_2744),\n","    \"MACS0416\":   (CENTER_RA_0416,  CENTER_DEC_0416),\n","    \"MACS0717\":   (CENTER_RA_0717,  CENTER_DEC_0717),\n","    \"MACS1149\":   (CENTER_RA_1149,  CENTER_DEC_1149),\n","    \"ABELLS1063\": (CENTER_RA_S1063, CENTER_DEC_S1063),\n","    \"ABELL370\":   (CENTER_RA_370,   CENTER_DEC_370),\n","}\n","\n","def noise_injection_shoulder_for_map(\n","    kappa_path,\n","    ra_str,\n","    dec_str,\n","    sigma_frac_list=(0.01, 0.02, 0.05),\n","    n_real=200,\n","    random_state=1234,\n","):\n","    \"\"\"\n","    Add Gaussian noise to κ and recompute the curvature-minimum radius R_sh.\n","\n","    For each noise level sigma_frac (fraction of global κ RMS), perform n_real\n","    noisy realisations, recomputing κ(R), curvature, and R_sh each time.\n","\n","    Returns:\n","        {\n","          'R_sh_fid' : fiducial (no-noise) R_sh (arcsec),\n","          'sigma_fracs': [...],\n","          'per_sigma': {\n","             sigma_frac: {\n","               'R_sh_array' : array of R_sh values (arcsec, may include NaN),\n","               'R_sh_clean' : finite subset,\n","               'mean'       : mean R_sh (clean),\n","               'std'        : std R_sh (clean),\n","               'p16','p50','p84' : percentiles,\n","               'n_real_eff' : number of finite R_sh\n","             }, ...\n","          }\n","        }\n","    \"\"\"\n","    # --- load map and WCS ---\n","    with fits.open(kappa_path) as hdul:\n","        data = hdul[0].data.astype(float)\n","        hdr  = hdul[0].header\n","\n","    w = WCS(hdr)\n","    pixscale = pixel_scale_arcsec(hdr)\n","\n","    # --- centre in pixels from WCS ---\n","    coord_c = SkyCoord(ra_str, dec_str, unit=(u.hourangle, u.deg))\n","    cx, cy = w.all_world2pix([[coord_c.ra.deg, coord_c.dec.deg]], 0)[0]\n","    cx, cy = float(cx), float(cy)\n","\n","    ny, nx = data.shape\n","    yy, xx = np.indices(data.shape)\n","    r_pix = np.sqrt((xx - cx)**2 + (yy - cy)**2)\n","\n","    # --- base valid mask (fixed) ---\n","    valid = np.ones_like(data, dtype=bool)\n","    if MASK_NAN:\n","        valid &= ~np.isnan(data)\n","    if MASK_ZERO:\n","        valid &= (data != 0.0)\n","\n","    # --- angular bins (same as profile_with_angular_bins) ---\n","    if BIN_SPACING == \"linear\":\n","        edges_arc = np.linspace(ANG_R_INNER, ANG_R_OUTER, N_BINS + 1)\n","    else:\n","        edges_arc = np.logspace(np.log10(ANG_R_INNER), np.log10(ANG_R_OUTER), N_BINS + 1)\n","    edges_pix = edges_arc / pixscale\n","    mids_arc  = 0.5 * (edges_arc[:-1] + edges_arc[1:])\n","\n","    # --- precompute annulus masks and keep only bins that pass MIN_VALID_FRACTION ---\n","    bin_R_arc = []\n","    bin_masks = []\n","\n","    for (rmin_pix, rmax_pix, rmid_arc) in zip(edges_pix[:-1], edges_pix[1:], mids_arc):\n","        ann = (r_pix >= rmin_pix) & (r_pix < rmax_pix)\n","        tot = ann.sum()\n","        if tot == 0:\n","            continue\n","        good = ann & valid\n","        N_valid = good.sum()\n","        if N_valid == 0:\n","            continue\n","        vfrac = N_valid / tot\n","        if vfrac >= MIN_VALID_FRACTION:\n","            bin_R_arc.append(rmid_arc)\n","            bin_masks.append(good)\n","\n","    bin_R_arc = np.asarray(bin_R_arc)\n","    if len(bin_R_arc) < 3:\n","        raise RuntimeError(\"Not enough usable bins for curvature estimate.\")\n","\n","    # --- helper: compute R_sh from a given κ map using precomputed masks ---\n","    def compute_R_sh_from_map(kappa_array):\n","        kappa_mean = []\n","        for mask in bin_masks:\n","            vals = kappa_array[mask]\n","            if vals.size == 0:\n","                kappa_mean.append(np.nan)\n","            else:\n","                kappa_mean.append(np.nanmean(vals))\n","        kappa_mean = np.asarray(kappa_mean)\n","\n","        dk  = np.gradient(kappa_mean, bin_R_arc)\n","        d2k = np.gradient(dk,         bin_R_arc)\n","\n","        mask_win = (bin_R_arc >= SHOULDER_RMIN) & (bin_R_arc <= SHOULDER_RMAX)\n","        Rw = bin_R_arc[mask_win]\n","        cw = d2k[mask_win]\n","        if len(Rw) >= 3 and np.isfinite(cw).sum() >= 3:\n","            idx = np.argmin(cw)\n","            return float(Rw[idx])\n","        else:\n","            return np.nan\n","\n","    # --- fiducial R_sh (no extra noise) ---\n","    R_sh_fid = compute_R_sh_from_map(data)\n","\n","    # --- global κ RMS for noise scaling ---\n","    kappa_rms = np.nanstd(data[valid])\n","    if (not np.isfinite(kappa_rms)) or (kappa_rms == 0.0):\n","        raise RuntimeError(\"Non-finite or zero κ RMS; cannot define noise scale.\")\n","\n","    rng = np.random.default_rng(random_state)\n","    per_sigma = {}\n","\n","    for sigma_frac in sigma_frac_list:\n","        sigma = sigma_frac * kappa_rms\n","        R_vals = []\n","\n","        for _ in range(n_real):\n","            noise = rng.normal(loc=0.0, scale=sigma, size=data.shape)\n","            noisy = data.copy()\n","            noisy[valid] = data[valid] + noise[valid]\n","\n","            R_val = compute_R_sh_from_map(noisy)\n","            R_vals.append(R_val)\n","\n","        R_vals = np.asarray(R_vals)\n","        R_clean = R_vals[np.isfinite(R_vals)]\n","\n","        if R_clean.size > 0:\n","            mean_R = float(np.mean(R_clean))\n","            std_R  = float(np.std(R_clean, ddof=1)) if R_clean.size > 1 else 0.0\n","            p16, p50, p84 = np.percentile(R_clean, [16, 50, 84])\n","        else:\n","            mean_R = std_R = p16 = p50 = p84 = np.nan\n","\n","        per_sigma[sigma_frac] = dict(\n","            R_sh_array=R_vals,\n","            R_sh_clean=R_clean,\n","            mean=mean_R,\n","            std=std_R,\n","            p16=p16,\n","            p50=p50,\n","            p84=p84,\n","            n_real_eff=int(R_clean.size),\n","        )\n","\n","    return dict(\n","        R_sh_fid=R_sh_fid,\n","        sigma_fracs=list(sigma_frac_list),\n","        per_sigma=per_sigma,\n","    )\n","\n","def run_noise_injection_for_all_maps(\n","    sigma_frac_list=(0.01, 0.02, 0.05),\n","    n_real=200,\n","    base_seed=5678,\n","):\n","    \"\"\"\n","    Run noise–injection curvature-minimum test for all 18 HFF maps.\n","\n","    Returns:\n","        df_summary : pandas DataFrame with one row per (map, sigma_frac)\n","        noise_dict : dict TAG -> noise-injection result dict\n","    \"\"\"\n","    rows = []\n","    noise_dict = {}\n","\n","    for key in sorted(HFF_OPTIONS.keys()):\n","        opt = HFF_OPTIONS[key]\n","        tag = opt[\"TAG\"]                 # e.g. \"ABELL2744_CATS\"\n","        cluster_token = tag.split(\"_\")[0]  # e.g. \"ABELL2744\"\n","        team_token    = tag.split(\"_\")[1]  # e.g. \"CATS\"\n","\n","        if cluster_token not in CLUSTER_CENTRES:\n","            raise KeyError(f\"No centre defined for cluster token '{cluster_token}'\")\n","\n","        ra_str, dec_str = CLUSTER_CENTRES[cluster_token]\n","\n","        print(f\"Running noise-injection for {tag} ...\")\n","        res = noise_injection_shoulder_for_map(\n","            opt[\"kappa\"],\n","            ra_str,\n","            dec_str,\n","            sigma_frac_list=sigma_frac_list,\n","            n_real=n_real,\n","            random_state=base_seed + key,\n","        )\n","        noise_dict[tag] = res\n","\n","        R_fid = res[\"R_sh_fid\"]\n","        for sigma_frac in res[\"sigma_fracs\"]:\n","            sres = res[\"per_sigma\"][sigma_frac]\n","            rows.append(dict(\n","                tag         = tag,\n","                cluster     = cluster_token,\n","                team        = team_token,\n","                sigma_frac  = sigma_frac,\n","                n_real_eff  = sres[\"n_real_eff\"],\n","                R_sh_fid    = R_fid,\n","                R_sh_mean   = sres[\"mean\"],\n","                R_sh_std    = sres[\"std\"],\n","                R_sh_p16    = sres[\"p16\"],\n","                R_sh_p50    = sres[\"p50\"],\n","                R_sh_p84    = sres[\"p84\"],\n","            ))\n","\n","    df_summary = (\n","        pd.DataFrame(rows)\n","        .sort_values([\"cluster\", \"team\", \"sigma_frac\"])\n","        .reset_index(drop=True)\n","    )\n","    return df_summary, noise_dict\n","\n","# --------------------------------------------------------------------\n","# Run noise–injection for all 18 maps\n","# (you can change sigma_frac_list or n_real if needed)\n","# --------------------------------------------------------------------\n","sigma_list = (0.01, 0.02, 0.05)\n","df_noise_summary, NOISE_RESULTS = run_noise_injection_for_all_maps(\n","    sigma_frac_list=sigma_list,\n","    n_real=200,\n","    base_seed=5678,\n",")\n","\n","display(df_noise_summary)\n","# Optional: save for later inspection\n","# df_noise_summary.to_csv(\"HFF_noise_injection_Rsh_summary.csv\", index=False)\n"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":391},"id":"_A2vno08mqT3","executionInf
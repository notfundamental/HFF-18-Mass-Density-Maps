sv\n"]}]},{"cell_type":"code","source":["# Cell 8: consolidate results, convert to kpc, and check edge coverage\n","\n","from astropy.cosmology import FlatLambdaCDM\n","\n","# Fiducial cosmology (match paper)\n","cosmo = FlatLambdaCDM(H0=67.4, Om0=0.315)\n","\n","if not ALL_RESULTS:\n","    raise RuntimeError(\"ALL_RESULTS is empty – run the cluster cells first.\")\n","\n","results_df = pd.DataFrame(ALL_RESULTS)\n","\n","# ---------- attach z_lens from HFF_OPTIONS ----------\n","tag_to_z = {v[\"TAG\"]: v[\"z\"] for v in HFF_OPTIONS.values()}\n","\n","def lookup_z(team):\n","    base = team.split(\"_\")[0]  # e.g. 'ABELL2744'\n","    for tag, z in tag_to_z.items():\n","        if tag.startswith(base):\n","            return z\n","    raise KeyError(f\"No z_lens found for team '{team}'\")\n","\n","results_df[\"z_lens\"] = results_df[\"team\"].map(lookup_z)\n","\n","# ---------- attach RA/DEC centres actually used ----------\n","cluster_to_center = {\n","    \"ABELL2744\":  (CENTER_RA_2744,  CENTER_DEC_2744),\n","    \"ABELL370\":   (CENTER_RA_370,   CENTER_DEC_370),\n","    \"ABELLS1063\": (CENTER_RA_S1063, CENTER_DEC_S1063),\n","    \"MACS0416\":   (CENTER_RA_0416,  CENTER_DEC_0416),\n","    \"MACS0717\":   (CENTER_RA_0717,  CENTER_DEC_0717),\n","    \"MACS1149\":   (CENTER_RA_1149,  CENTER_DEC_1149),\n","}\n","\n","results_df[\"RA_center\"]  = results_df[\"cluster\"].map(lambda c: cluster_to_center[c][0])\n","results_df[\"DEC_center\"] = results_df[\"cluster\"].map(lambda c: cluster_to_center[c][1])\n","\n","# ---------- convert shoulder radii from arcsec to kpc ----------\n","D_A = cosmo.angular_diameter_distance(results_df[\"z_lens\"]).to(u.kpc).value  # kpc\n","arcsec_to_rad = (1.0 * u.arcsec).to(u.rad).value\n","results_df[\"R_sh_kpc\"] = results_df[\"R_sh_arcsec\"] * arcsec_to_rad * D_A\n","\n","# Round to 0.1 arcsec / 0.1 kpc to reflect binning resolution\n","results_df[\"R_sh_arcsec\"] = results_df[\"R_sh_arcsec\"].round(1)\n","results_df[\"R_sh_kpc\"]    = results_df[\"R_sh_kpc\"].round(1)\n","\n","# ---------- edge-coverage diagnostic (90% valid fraction radius) ----------\n","\n","EDGE_OUTER_ARCSEC = 200.0   # look a bit beyond 150\"\n","EDGE_N_BINS       = 50\n","EDGE_THRESHOLD    = 0.9     # 90% coverage threshold\n","\n","def edge_radius_for_map(kappa_path, ra_str, dec_str):\n","    \"\"\"\n","    Diagnostic: for one map, compute valid_fraction vs R and\n","    return the first radius where valid_fraction < EDGE_THRESHOLD.\n","    \"\"\"\n","    hdul = fits.open(kappa_path)\n","    data = hdul[0].data\n","    hdr  = hdul[0].header\n","    hdul.close()\n","\n","    w = WCS(hdr)\n","    pixscale = pixel_scale_arcsec(hdr)\n","\n","    coord_c = SkyCoord(ra_str, dec_str, unit=(u.hourangle, u.deg))\n","    cx, cy = w.all_world2pix([[coord_c.ra.deg, coord_c.dec.deg]], 0)[0]\n","    cx, cy = float(cx), float(cy)\n","\n","    ny, nx = data.shape\n","    yy, xx = np.indices(data.shape)\n","    r_pix = np.sqrt((xx - cx)**2 + (yy - cy)**2)\n","\n","    valid = np.ones_like(data, dtype=bool)\n","    valid &= ~np.isnan(data)\n","    valid &= (data != 0.0)\n","\n","    edges_arc = np.linspace(0.0, EDGE_OUTER_ARCSEC, EDGE_N_BINS + 1)\n","    edges_pix = edges_arc / pixscale\n","    mids_arc  = 0.5 * (edges_arc[:-1] + edges_arc[1:])\n","\n","    frac = []\n","    for rmin_pix, rmax_pix in zip(edges_pix[:-1], edges_pix[1:]):\n","        ann = (r_pix >= rmin_pix) & (r_pix < rmax_pix)\n","        tot = ann.sum()\n","        if tot == 0:\n","            frac.append(0.0)\n","            continue\n","        good = ann & valid\n","        frac.append(good.sum() / tot)\n","\n","    frac = np.array(frac)\n","    mids_arc = np.array(mids_arc)\n","\n","    bad = frac < EDGE_THRESHOLD\n","    if not np.any(bad):\n","        return np.nan  # no obvious edge within EDGE_OUTER_ARCSEC\n","    return float(mids_arc[bad][0])\n","\n","# compute edge radii and margins for each map\n","R_edge_list   = []\n","margin_list   = []\n","\n","for _, row in results_df.iterrows():\n","    team      = row[\"team\"]\n","    ra_str    = row[\"RA_center\"]\n","    dec_str   = row[\"DEC_center\"]\n","    R_sh      = row[\"R_sh_arcsec\"]\n","\n","    # find matching HFF_OPTIONS entry by TAG (team strings match TAG exactly)\n","    opt = next(v for v in HFF_OPTIONS.values() if v[\"TAG\"] == team)\n","    kappa_path = opt[\"kappa\"]\n","\n","    R_edge = edge_radius_for_map(kappa_path, ra_str, dec_str)\n","    R_edge_list.append(R_edge)\n","\n","    if not np.isnan(R_edge) and not np.isnan(R_sh):\n","        margin_list.append(R_edge - R_sh)\n","    else:\n","        margin_list.append(np.nan)\n","\n","results_df[\"R_edge90_arcsec\"] = np.array(R_edge_list).round(1)\n","results_df[\"margin_arcsec\"]   = np.array(margin_list).round(1)\n","\n","# ---------- final ordering, display, and save ----------\n","\n","results_df = results_df[\n","    [\n","        \"cluster\",\n","        \"team\",\n","        \"z_lens\",\n","        \"RA_center\",\n","        \"DEC_center\",\n","        \"R_sh_arcsec\",\n","        \"R_sh_kpc\",\n","        \"R_edge90_arcsec\",\n","        \"margin_arcsec\",\n","    ]\n","].sort_values([\"cluster\", \"team\"]).reset_index(drop=True)\n","\n","display(results_df)\n","print(f\"Total maps: {len(results_df)}\")\n","print(f\"Maps with finite shoulders: {results_df['R_sh_arcsec'].notna().sum()}\")\n","\n","results_df.to_csv(\"HFF_shoulders_20_80arcsec_rawcurv_benchmark.csv\", index=False)\n","print(\"Saved: HFF_shoulders_20_80arcsec_rawcurv_benchmark.csv\")\n"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":0},"id":"P3p5Yce2OoKU","executionInfo":{"status":"ok","timestamp":1765301216461,"user_tz":0,"elapsed":73040,"user":{"displayName":"Jon Axworthy","userId":"03410905867559825123"}},"outputId":"20be8acd-0c29-4b1b-c1ea-305354eceb16"},"execution_count":67,"outputs":[{"output_type":"display_data","data":{"text/plain":["       cluster               team  z_lens     RA_center    DEC_center  \\\
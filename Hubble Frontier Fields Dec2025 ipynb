l jackknife test for κ(R) and d²κ/dR² in angular wedges\n","\n","import numpy as np\n","import matplotlib.pyplot as plt\n","from astropy.io import fits\n","from astropy.wcs import WCS\n","from astropy.coordinates import SkyCoord\n","import astropy.units as u\n","\n","# Helper: map TAG -> (RA, DEC) using your existing centre variables\n","def get_cluster_center_from_HFF(team_tag):\n","    \"\"\"\n","    team_tag example: 'ABELL2744_CATS'.\n","    Returns (RA_string, DEC_string) for the corresponding cluster centre.\n","    \"\"\"\n","    cluster = team_tag.split(\"_\")[0]\n","\n","    if cluster == \"ABELL2744\":\n","        return CENTER_RA_2744, CENTER_DEC_2744\n","    if cluster == \"MACS0416\":\n","        return CENTER_RA_0416, CENTER_DEC_0416\n","    if cluster == \"MACS0717\":\n","        return CENTER_RA_0717, CENTER_DEC_0717\n","    if cluster == \"MACS1149\":\n","        return CENTER_RA_1149, CENTER_DEC_1149\n","    if cluster == \"ABELLS1063\":\n","        return CENTER_RA_S1063, CENTER_DEC_S1063\n","    if cluster == \"ABELL370\":\n","        return CENTER_RA_370, CENTER_DEC_370\n","\n","    raise ValueError(f\"Cluster not recognised from TAG: {team_tag}\")\n","\n","def azimuthal_jackknife(team_tag, n_wedges=4):\n","    \"\"\"\n","    Azimuthal jackknife: split the κ-map into n_wedges (in polar angle)\n","    around the WCS centre and compare κ(R) and d²κ/dR² per wedge vs all-wedge.\n","\n","    Parameters\n","    ----------\n","    team_tag : str\n","        e.g. 'ABELL2744_CATS', 'MACS0416_GLAFIC', ...\n","    n_wedges : int\n","        Number of azimuthal wedges (default 4 -> 0–90, 90–180, ...).\n","    \"\"\"\n","    # Find HFF_OPTIONS entry\n","    opt_list = [v for v in HFF_OPTIONS.values() if v[\"TAG\"] == team_tag]\n","    if len(opt_list) != 1:\n","        raise RuntimeError(f\"Expected exactly one HFF_OPTIONS entry for TAG='{team_tag}', found {len(opt_list)}\")\n","    opt = opt_list[0]\n","    kappa_path = opt[\"kappa\"]\n","\n","    # Centre from your existing RA/DEC definitions\n","    ra_str, dec_str = get_cluster_center_from_HFF(team_tag)\n","    cluster = team_tag.split(\"_\")[0]\n","    team    = team_tag.split(\"_\")[1]\n","\n","    # Load map and WCS\n","    with fits.open(kappa_path, memmap=True) as hdul:\n","        data = hdul[0].data.astype(float)\n","        hdr  = hdul[0].header\n","\n","    w = WCS(hdr)\n","    pixscale = pixel_scale_arcsec(hdr)  # uses your existing helper\n","\n","    # Centre in pixels\n","    coord_c = SkyCoord(ra_str, dec_str, unit=(u.hourangle, u.deg))\n","    cx, cy = w.all_world2pix([[coord_c.ra.deg, coord_c.dec.deg]], 0)[0]\n","    cx, cy = float(cx), float(cy)\n","\n","    ny, nx = data.shape\n","    yy, xx = np.indices(data.shape)\n","    dx = xx - cx\n","    dy = yy - cy\n","\n","    r_pix = np.sqrt(dx**2 + dy**2)\n","    r_arc = r_pix * pixscale\n","\n","    # Azimuth angle in [0, 2π)\n","    theta = np.arctan2(dy, dx)  # [-π, +π]\n","    theta = np.mod(theta, 2.0 * np.pi)\n","\n","    # Base validity (as in main pipeline)\n","    valid = np.ones_like(data, dtype=bool)\n","    if MASK_NAN:\n","        valid &= np.isfinite(data)\n","    if MASK_ZERO:\n","        valid &= (data != 0.0)\n","\n","    # Radial bins (same as main analysis)\n","    if BIN_SPACING == \"linear\":\n","        edges_arc = np.linspace(ANG_R_INNER, ANG_R_OUTER, N_BINS + 1)\n","    else:\n","        edges_arc = np.logspace(np.log10(ANG_R_INNER), np.log10(ANG_R_OUTER), N_BINS + 1)\n","    mids_arc = 0.5 * (edges_arc[:-1] + edges_arc[1:])\n","    edges_pix = edges_arc / pixscale\n","\n","    # Wedge index for each pixel\n","    wedge_width = 2.0 * np.pi / n_wedges\n","    wedge_idx = np.floor(theta / wedge_width).astype(int)\n","    wedge_idx = np.clip(wedge_idx, 0, n_wedges - 1)\n","\n","    # Collect per-bin values: all-wedge and per-wedge\n","    bin_R_all = []\n","    bin_vals_all = []\n","\n","    bin_R_wedges = [[] for _ in range(n_wedges)]\n","    bin_vals_wedges = [[] for _ in range(n_wedges)]\n","\n","    for (rmin_pix, rmax_pix, rmid_arc) in zip(edges_pix[:-1], edges_pix[1:], mids_arc):\n","        ann = (r_pix >= rmin_pix) & (r_pix < rmax_pix)\n","        tot = ann.sum()\n","        if tot == 0:\n","            continue\n","\n","        good = ann & valid\n","        N_valid = good.sum()\n","        if N_valid == 0:\n","            continue\n","\n","        vfrac = N_valid / tot\n","        if vfrac < MIN_VALID_FRACTION:\n","            continue\n","\n","        # All-wedge values\n","        vals_all = data[good]\n","        bin_R_all.append(rmid_arc)\n","        bin_vals_all.append(vals_all.astype(float))\n","\n","        # Per-wedge values\n","        for w_id in range(n_wedges):\n","            mask_w = good & (wedge_idx == w_id)\n","            if not np.any(mask_w):\n","                continue\n","            vals_w = data[mask_w]\n","            bin_R_wedges[w_id].append(rmid_arc)\n","            bin_vals_wedges[w_id].append(vals_w.astype(float))\n","\n","    bin_R_all = np.asarray(bin_R_all)\n","    if bin_R_all.size < 3:\n","        raise RuntimeError(\"Not enough usable bins for jackknife.\")\n","\n","    # Fiducial κ(R) and curvature (all wedges)\n","    kappa_all = np.array([v.mean() for v in bin_vals_all])\n","    dk_all = np.gradient(kappa_all, bin_R_all)\n","    d2k_all = np.gradient(dk_all,   bin_R_all)\n","\n","    mask_win_all = (bin_R_all >= SHOULDER_RMIN) & (bin_R_all <= SHOULDER_RMAX)\n","    if np.any(mask_win_all):\n","        Rw_all = bin_R_all[mask_win_all]\n","        cw_all = d2k_all[mask_win_all]\n","        idx_all = np.argmin(cw_all)\n","        R_sh_all = float(Rw_all[idx_all])\n","    else:\n","        R_sh_all = np.nan\n","\n","    # Wedge-wise κ(R) and curvature\n","    wedge_results = []\n","    for w_id in range(n_wedges):\n","        R_w = np.asarray(bin_R_wedges[w_id])\n","        if R_w.size < 3:\n","            wedge_results.append(dict(\n","                wedge=w_id,\n","                phi_min= w_id      * 360.0 / n_wedges,\n","                phi_max=(w_id + 1) * 360.0 / n_wedges,\n","                R_arc=R_w,\n","                kappa_mean=None,\n","                d2k=None,\n","                R_sh=np.nan\n","            ))\n","            continue\n","\n","        kappa_w = np.array([v.mean() for v in bin_vals_wedges[w_id]])\n","        dk_w = np.gradient(kappa_w, R_w)\n","        d2k_w = np.gradient(dk_w,   R_w)\n","\n","        mask_win_w = (R_w >= SHOULDER_RMIN) & (R_w <= SHOULDER_RMAX)\n","        if np.any(mask_win_w):\n","            Rw = R_w[mask_win_w]\n","            cw = d2k_w[mask_win_w]\n","            idx = np.argmin(cw)\n","            R_sh_w = float(Rw[idx])\n","        else:\n","            R_sh_w = np.nan\n","\n","        wedge_results.append(dict(\n","            wedge=w_id,\n","            phi_min= w_id      * 360.0 / n_wedges,\n","            phi_max=(w_id + 1) * 360.0 / n_wedges,\n","            R_arc=R_w,\n","            kappa_mean=kappa_w,\n","            d2k=d2k_w,\n","            R_sh=R_sh_w\n","        ))\n","\n","    # --- plotting ---\n","    fig, (ax1, ax2) = plt.subplots(2, 1, figsize=(7, 7), sharex=True)\n","\n","    # κ(R)\n","    ax1.plot(bin_R_all, kappa_all, \"k-\", lw=2.0, label=f\"All wedges (R_sh≈{R_sh_all:.1f}\\\")\")\n","    for wr in wedge_results:\n","        if wr[\"kappa_mean\"] is None:\n","            continue\n","        label = f\"Wedge {wr['wedge']} ({wr['phi_min']:.0f}–{wr['phi_max']:.0f}°), R_sh≈{wr['R_sh']:.1f}\\\"\"\n","        ax1.plot(wr[\"R_arc\"], wr[\"kappa_mean\"], lw=1.0, alpha=0.7, label=label)\n","\n","    if np.isfinite(R_sh_all):\n","        ax1.axvline(R_sh_all, color=\"k\", ls=\"--\", lw=1.2, alpha=0.8)\n","\n","    ax1.set_ylabel(r\"$\\kappa(R)$\")\n","    ax1.set_title(f\"{cluster} {team}: azimuthal jackknife (n_wedges={n_wedges})\")\n","    ax1.grid(alpha=0.3)\n","    ax1.legend(fontsize=7, frameon=True, ncol=1)\n","\n","    # d²κ/dR²\n","    ax2.plot(bin_R_all, d2k_all, \"k-\", lw=2.0, label=f\"All wedges (R_sh≈{R_sh_all:.1f}\\\")\")\n","    for wr in wedge_results:\n","        if wr[\"d2k\"] is None:\n","            continue\n","        label = f\"Wedge {wr['wedge']} ({wr['phi_min']:.0f}–{wr['phi_max']:.0f}°)\"\n","        ax2.plot(wr[\"R_arc\"], wr[\"d2k\"], lw=1.0, alpha=0.7, label=label)\n","        if np.isfinite(wr[\"R_sh\"]):\n","            ax2.axvline(wr[\"R_sh\"], color=\"grey\", ls=\":\", lw=0.8, alpha=0.7)\n","\n","    if np.isfinite(R_sh_all):\n","        ax2.axvline(R_sh_all, color=\"k\", ls=\"--\", lw=1.2, alpha=0.8)\n","\n","    ax2.axhline(0.0, color=\"k\", lw=0.8, alpha=0.5)\n","    ax2.set_xlabel(r\"$R\\ {\\rm (arcsec)}$\")\n","    ax2.set_ylabel(r\"$d^2\\kappa/dR^2$\")\n","    ax2.grid(alpha=0.3)\n","    ax2.legend(fontsize=7, frameon=True, ncol=1)\n","\n","    plt.tight_layout()\n","    plt.show()\n","\n","    # simple text summary for the notebook\n","    print(f\"Azimuthal jackknife for {team_tag}:\")\n","    print(f\"  All-wedge R_sh ≈ {R_sh_all:.2f}\\\"\")\n","    for wr in wedge_results:\n","        print(f\"  Wedge {wr['wedge']} ({wr['phi_min']:.0f}–{wr['phi_max']:.0f}°): \"\n","              f\"R_sh ≈ {wr['R_sh']:.2f}\\\"\")\n","\n","# Example usage (uncomment one at a time as needed):\n","azimuthal_jackknife(\"ABELL2744_CATS\")\n","# azimuthal_jackknife(\"MACS0416_CATS\")\n","# azimuthal_jackknife(\"MACS0717_CATS\")\n","# azimuthal_jackknife(\"MACS1149_CATS\")\n","# azimuthal_jackknife(\"ABELLS1063_CATS\")\n","# azimuthal_jackknife(\"ABELL370_CATS\")\n"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":811},"id":"a_AiSyx6Aa_l","executionInfo":{"status":"ok","timestamp":1765318531558,"user_tz":0,"elapsed":7473,"user":{"displayName":"Jon Axworthy","userId":"03410905867559825123"}},"outputId":"563a9d30-63ac-46d9-bce4-a8a63ce83e59"},"execution_count":128,"outputs":[{"output_type":"display_data","data":{"text/plain":["<Figure size 700x700 with 2 Axes>"],"image/png":"\n"},"metadata":{}},{"output_type":"stream","name":"stdout","text":["Azimuthal jackknife for ABELL2744_CATS:\n","  All-wedge R_sh ≈ 43.80\"\n","  Wedge 0 (0–90°): R_sh ≈ 47.40\"\n","  Wedge 1 (90–180°): R_sh ≈ 79.80\"\n","  Wedge 2 (180–270°): R_sh ≈ 65.40\"\n","  Wedge 3 (270–360°): R_sh ≈ 36.60\"\n"]}]},{"cell_type":"markdown","source":["#MOCK K MAP LCDM-like"],"metadata":{"id":"QWIlojH-uvKe"}},{"cell_type":"code","source":["# Cell: Generate a synthetic ΛCDM-like NFW κ-map and register as a mock\n","\n","import os\n","import numpy as np\n","from astropy.io import fits\n","from astropy.wcs import WCS\n","\n","# --------------------------------------------------------------------\n","# Configuration for the synthetic cluster\n","# --------------------------------------------------------------------\n","\n","# HFF-like grid / resolution\n","NPIX = 1024                   # pixels per side\n","PIX_SCALE_ARCSEC = 0.06       # arcsec/pixel (CATS-like)\n","\n","# NFW shape parameters (angular only; absolute mass not needed for curvature)\n","R200_ARCSEC = 300.0           # \"virial\" radius in arcsec (HFF-scale)\n","CONC        = 4.0             # concentration c200\n","RS_ARCSEC   = R200_ARCSEC / CONC\n","\n","# Convergence amplitude (shape matters, not absolute normalisation)\n","KAPPA_S = 0.4                 # central κ scale\n","\n","# Simple projected ellipticity (triaxial proxy)\n","AXIS_RATIO_Q        = 0.6     # q = b/a < 1 => elongated\n","POSITION_ANGLE_DEG  = 30.0    # degrees, CCW from +x (RA increasing)\n","\n","# Output path (expects BASE_PATH from setup cell)\n","MOCK_SUBDIR   = f\"{BASE_PATH}mocks/\"\n","MOCK_FILENAME = os.path.join(MOCK_SUBDIR, \"lcdm_mock_nfw_cluster1_kappa.fits\")\n","os.makedirs(MOCK_SUBDIR, exist_ok=True)\n","\n","# --------------------------------------------------------------------\n","# Projected NFW κ(R) (Bartelmann 1996 form; shape only)\n","# --------------------------------------------------------------------\n","def kappa_nfw(R_arcsec, rs_arcsec, kappa_s):\n","    \"\"\"\n","    Projected NFW convergence κ(R) in terms of:\n","      R_arcsec : radius in arcsec\n","      rs_arcsec: scale radius in arcsec\n","      kappa_s  : amplitude scale\n","\n","    Returns dimensionless κ(R).\n","    \"\"\"\n","    x = np.asarray(R_arcsec, dtype=float) / rs_arcsec\n","    k = np.zeros_like(x)\n","\n","    # avoid exact zero\n","    eps = 1e-6\n","    x_safe = np.where(x == 0.0, eps, x)\n","\n","    # x < 1\n","    mask1 = x_safe < 1.0\n","    if np.any(mask1):\n","        xm = x_safe[mask1]\n","        f = np.arctanh(np.sqrt(1.0 - xm**2)) / np.sqrt(1.0 - xm**2)\n","        k[mask1] = 2.0 * kappa_s * f / (xm**2 - 1.0)\n","\n","    # x = 1\n","    mask2 = np.isclose(x_safe, 1.0, atol=1e-4)\n","    if np.any(mask2):\n","        k[mask2] = 2.0 * kappa_s / 3.0\n","\n","    # x > 1\n","    mask3 = x_safe > 1.0\n","    if np.any(mask3):\n","        xp = x_safe[mask3]\n","        f = np.arctan(np.sqrt(xp**2 - 1.0)) / np.sqrt(xp**2 - 1.0)\n","        k[mask3] = 2.0 * kappa_s * f / (xp**2 - 1.0)\n","\n","    return k\n","\n","# --------------------------------------------------------------------\n","# Build the 2D κ-grid in angular coordinates\n","# --------------------------------------------------------------------\n","y_idx, x_idx = np.indices((NPIX, NPIX))\n","cx = (NPIX - 1) / 2.0\n","cy = (NPIX - 1) / 2.0\n","\n","dx_pix = x_idx - cx\n","dy_pix = y_idx - cy\n","\n","dx_arc = dx_pix * PIX_SCALE_ARCSEC\n","dy_arc = dy_pix * PIX_SCALE_ARCSEC\n","\n","# rotate coordinates by position angle\n","theta = np.deg2rad(POSITION_ANGLE_DEG)\n","cos_t, sin_t = np.cos(theta), np.sin(theta)\n","\n","x_rot =  dx_arc * cos_t + dy_arc * sin_t\n","y_rot = -dx_arc * sin_t + dy_arc * cos_t\n","\n","# elliptical radius (simple projected axis ratio)\n","R_ell_arc = np.sqrt(x_rot**2 + (y_rot / AXIS_RATIO_Q)**2)\n","\n","# κ(R) on the grid\n","kappa_map = kappa_nfw(R_ell_arc, RS_ARCSEC, KAPPA_S)\n","\n","# mask outskirts to mimic finite cluster extent (cosmetic)\n","R_max_arc = R200_ARCSEC * 1.2\n","kappa_map[R_ell_arc > R_max_arc] = 0.0\n","\n","# --------------------------------------------------------------------\n","# Minimal WCS header so the main pipeline works unchanged\n","# --------------------------------------------------------------------\n","w = WCS(naxis=2)\n","# reference pixel at centre\n","w.wcs.crpix = [cx + 1.0, cy + 1.0]\n","# dummy RA/DEC at centre (values not used by curvature pipeline)\n","w.wcs.crval = [0.0, 0.0]\n","# pixel scale in degrees (RA negative convention)\n","pix_scale_deg = PIX_SCALE_ARCSEC / 3600.0\n","w.wcs.cdelt = np.array([-pix_scale_deg, pix_scale_deg])\n","w.wcs.ctype = [\"RA---TAN\", \"DEC--TAN\"]\n","\n","hdr = w.to_header()\n","hdr[\"BUNIT\"]  = \"dimensionless\"\n","hdr[\"COMMENT\"] = \"Synthetic LCDM-like NFW cluster kappa map for curvature tests.\"\n","\n","hdu  = fits.PrimaryHDU(data=kappa_map.astype(np.float32), header=hdr)\n","hdul = fits.HDUList([hdu])\n","hdul.writeto(MOCK_FILENAME, overwrite=True)\n","\n","print(\"Written synthetic κ-map to:\")\n","print(\"  \", MOCK_FILENAME)\n","\n","# --------------------------------------------------------------------\n","# Register this mock in MOCK_OPTIONS for downstream use\n","# --------------------------------------------------------------------\n","MOCK_OPTIONS = {\n","    1: dict(\n","        TAG=\"LCDM_MOCK_NFW1\",\n","        z=0.4,                # dummy lens redshift; curvature uses angular units only\n","        kappa=MOCK_FILENAME,\n","        RA=\"00:00:00.0\",\n","        DEC=\"+00:00:00.0\",\n","    )\n","}\n","\n","print(\"Registered MOCK_OPTIONS[1] with TAG =\", MOCK_OPTIONS[1][\"TAG\"])\n"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"Czw5bWZKzaMw","executionInfo":{"status":"ok","timestamp":1765312205501,"user_tz":0,"elapsed":319,"user":{"displayName":"Jon Axworthy","userId":"03410905867559825123"}},"outputId":"c65b63aa-528b-45b8-a9bd-19fea28c71e7"},"execution_count":86,"outputs":[{"output_type":"stream","name":"stdout","text":["Written synthetic κ-map to:\n","   /content/drive/MyDrive/grtt/grtt_source_data/mocks/lcdm_mock_nfw_cluster1_kappa.fits\n","Registered MOCK_OPTIONS[1] with TAG = LCDM_MOCK_NFW1\n"]}]},{"cell_type":"code","source":["# Cell: Curvature profile for the synthetic ΛCDM-like NFW mock\n","\n","mock1 = profile_with_angular_bins(\n","    MOCK_OPTIONS[1][\"kappa\"],\n","    MOCK_OPTIONS[1][\"RA\"],\n","    MOCK_OPTIONS[1][\"DEC\"],\n","    MOCK_OPTIONS[1][\"TAG\"]\n",")\n","\n","print(f\"Mock NFW shoulder radius R_sh ≈ {mock1['R_sh']:.2f} arcsec\")\n","\n","plt.figure(figsize=(6,4))\n","plt.plot(mock1[\"R_arcsec\"], mock1[\"d2k\"], \"o-\", ms=3)\n","plt.axvline(mock1[\"R_sh\"], ls=\"--\", color=\"r\", label=f\"R_sh ≈ {mock1['R_sh']:.1f}\\\"\")\n","plt.axhline(0, color=\"k\", lw=0.8, alpha=0.5)\n","\n","plt.xlabel(\"R (arcsec)\")\n","plt.ylabel(r\"$d^2\\kappa/dR^2$ (raw)\")\n","plt.title(\"Synthetic ΛCDM-like NFW mock: curvature profile\")\n","plt.legend(fontsize=8)\n","plt.tight_layout()\n","plt.show()\n"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":424},"id":"PAm_rirxz7Lv","executionInfo":{"status":"ok","timestamp":1765312335151,"user_tz":0,"elapsed":617,"user":{"displayName":"Jon Axworthy","userId":"03410905867559825123"}},"outputId":"0fcd1f43-a6c8-4a66-fc00-c1ae07affa50"},"execution_count":88,"outputs":[{"output_type":"stream","name":"stdout","text":["Mock NFW shoulder radius R_sh ≈ 40.20 arcsec\n"]},{"output_type":"display_data","data":{"text/plain":["<Figure size 600x400 with 1 Axes>"],"image/png":"\n"},"metadata":{}}]},{"cell_type":"code","source":["# Cell: Generate LCDM-like kappa map with main NFW halo + second halo + subhalos\n","\n","import numpy as np\n","from astropy.io import fits\n","from astropy.wcs import WCS\n","import os\n","\n","# --- grid / resolution (HFF-like) ---\n","NPIX = 1024                  # pixels per side\n","PIX_SCALE_ARCSEC = 0.06      # arcsec per pixel\n","\n","# --- main halo parameters (cluster-scale NFW) ---\n","R200_MAIN_ARCSEC = 300.0     # approximate virial radius in arcsec\n","CONC_MAIN        = 4.0       # concentration c200\n","RS_MAIN_ARCSEC   = R200_MAIN_ARCSEC / CONC_MAIN\n","KAPPA_S_MAIN     = 0.4       # amplitude (shape only matters for curvature)\n","\n","AXIS_RATIO_MAIN  = 0.7       # projected axis ratio b/a\n","PA_MAIN_DEG      = 20.0      # position angle of major axis\n","\n","# --- second halo (merger) ---\n","MASS_RATIO_SECOND   = 0.3    # M_second / M_main; sets relative kappa_s\n","R200_SECOND_ARCSEC  = R200_MAIN_ARCSEC * MASS_RATIO_SECOND**(1/3)\n","CONC_SECOND         = 4.0\n","RS_SECOND_ARCSEC    = R200_SECOND_ARCSEC / CONC_SECOND\n","KAPPA_S_SECOND      = KAPPA_S_MAIN * MASS_RATIO_SECOND**(1/3)\n","\n","SEPARATION_SECOND_ARCSEC = 80.0  # separation from main in arcsec\n","PA_SECOND_OFFSET_DEG     = -40.0 # angle of the offset from main centre\n","\n","AXIS_RATIO_SECOND   = 0.8\n","PA_SECOND_DEG       = -10.0\n","\n","# --- subhalo population ---\n","N_SUBHALOS        = 60           # number of subhalos\n","SUB_R_MAX_ARCSEC  = 250.0        # radial extent for subhalos\n","RS_SUB_MIN_ARC    = 3.0          # scale radius range for subhalos\n","RS_SUB_MAX_ARC    = 20.0\n","KAPPA_S_SUB_MIN   = 0.01         # amplitude range\n","KAPPA_S_SUB_MAX   = 0.05\n","SUB_AXIS_RATIO_MEAN = 0.8\n","SUB_AXIS_RATIO_SIG  = 0.1\n","\n","# --- output path ---\n","MOCK_SUBDIR   = f\"{BASE_PATH}mocks/\"\n","os.makedirs(MOCK_SUBDIR, exist_ok=True)\n","MOCK_FILENAME = MOCK_SUBDIR + \"lcdm_mock_cluster_main2nd_subhalos_kappa.fits\"\n","\n","# ------------------------------------------------\n","# helper: projected NFW kappa profile (shape only)\n","# ------------------------------------------------\n","def kappa_nfw(R_arcsec, rs_arcsec, kappa_s):\n","    \"\"\"\n","    Projected NFW convergence kappa(R), normalised by kappa_s.\n","    R, rs in arcsec. Returns dimensionless kappa.\n","    \"\"\"\n","    x = np.asarray(R_arcsec, dtype=float) / rs_arcsec\n","    k = np.zeros_like(x)\n","\n","    eps = 1e-6\n","    x_safe = np.where(x == 0, eps, x)\n","\n","    mask1 = x_safe < 1.0\n","    if np.any(mask1):\n","        xm = x_safe[mask1]\n","        f = np.arctanh(np.sqrt(1 - xm**2)) / np.sqrt(1 - xm**2)\n","        k[mask1] = 2 * kappa_s * f / (xm**2 - 1)\n","\n","    mask2 = np.isclose(x_safe, 1.0, atol=1e-4)\n","    if np.any(mask2):\n","        k[mask2] = 2 * kappa_s / 3.0\n","\n","    mask3 = x_safe > 1.0\n","    if np.any(mask3):\n","        xp = x_safe[mask3]\n","        f = np.arctan(np.sqrt(xp**2 - 1)) / np.sqrt(xp**2 - 1)\n","        k[mask3] = 2 * kappa_s * f / (xp**2 - 1)\n","\n","    return k\n","\n","# ------------------------------------------------\n","# build grid in angular coordinates\n","# ------------------------------------------------\n","y_idx, x_idx = np.indices((NPIX, NPIX))\n","cx = (NPIX - 1) / 2.0\n","cy = (NPIX - 1) / 2.0\n","\n","dx_pix = x_idx - cx\n","dy_pix = y_idx - cy\n","\n","dx_arc = dx_pix * PIX_SCALE_ARCSEC\n","dy_arc = dy_pix * PIX_SCALE_ARCSEC\n","\n","# ------------------------------------------------\n","# function to add an elliptical NFW halo to a kappa grid\n","# ------------------------------------------------\n","def add_elliptical_nfw(kappa_grid,\n","                       x0_arcsec, y0_arcsec,\n","                       rs_arcsec, kappa_s,\n","                       axis_ratio, pa_deg):\n","    \"\"\"\n","    Add an elliptical NFW halo to kappa_grid.\n","    (x0_arcsec, y0_arcsec) are halo centre offsets from grid centre in arcsec.\n","    axis_ratio = b/a, pa_deg = position angle of major axis (deg, CCW from +x).\n","    \"\"\"\n","    # shift coordinates\n","    x_rel = dx_arc - x0_arcsec\n","    y_rel = dy_arc - y0_arcsec\n","\n","    # rotate by PA\n","    theta = np.deg2rad(pa_deg)\n","    cos_t, sin_t = np.cos(theta), np.sin(theta)\n","    x_rot =  x_rel * cos_t + y_rel * sin_t\n","    y_rot = -x_rel * sin_t + y_rel * cos_t\n","\n","    # elliptical radius\n","    R_ell_arc = np.sqrt(x_rot**2 + (y_rot / axis_ratio)**2)\n","\n","    # add NFW kappa\n","    kappa_grid += kappa_nfw(R_ell_arc, rs_arcsec, kappa_s)\n","\n","# ------------------------------------------------\n","# start with an empty kappa grid\n","# ------------------------------------------------\n","kappa_total = np.zeros_like(dx_arc, dtype=np.float32)\n","\n","# --- main halo at grid centre ---\n","add_elliptical_nfw(\n","    kappa_total,\n","    x0_arcsec=0.0,\n","    y0_arcsec=0.0,\n","    rs_arcsec=RS_MAIN_ARCSEC,\n","    kappa_s=KAPPA_S_MAIN,\n","    axis_ratio=AXIS_RATIO_MAIN,\n","    pa_deg=PA_MAIN_DEG,\n",")\n","\n","# --- second halo (merger), offset from centre ---\n","theta_off = np.deg2rad(PA_SECOND_OFFSET_DEG)\n","x_off_arc = SEPARATION_SECOND_ARCSEC * np.cos(theta_off)\n","y_off_arc = SEPARATION_SECOND_ARCSEC * np.sin(theta_off)\n","\n","add_elliptical_nfw(\n","    kappa_total,\n","    x0_arcsec=x_off_arc,\n","    y0_arcsec=y_off_arc,\n","    rs_arcsec=RS_SECOND_ARCSEC,\n","    kappa_s=KAPPA_S_SECOND,\n","    axis_ratio=AXIS_RATIO_SECOND,\n","    pa_deg=PA_SECOND_DEG,\n",")\n","\n","# --- subhalo population ---\n","rng = np.random.default_rng(12345)\n","\n","# radial positions: draw radii with PDF ~ R (uniform in area) up to SUB_R_MAX_ARCSEC\n","u = rng.random(N_SUBHALOS)\n","R_sub = SUB_R_MAX_ARCSEC * np.sqrt(u)\n","phi_sub = 2 * np.pi * rng.random(N_SUBHALOS)\n","\n","x_sub_arc = R_sub * np.cos(phi_sub)\n","y_sub_arc = R_sub * np.sin(phi_sub)\n","\n","# scale radii and amplitudes from simple log-uniform distributions\n","RS_sub = 10.0 ** rng.uniform(np.log10(RS_SUB_MIN_ARC), np.log10(RS_SUB_MAX_ARC), N_SUBHALOS)\n","KAPPA_S_sub = 10.0 ** rng.uniform(np.log10(KAPPA_S_SUB_MIN), np.log10(KAPPA_S_SUB_MAX), N_SUBHALOS)\n","\n","# axis ratios around a mean with some scatter, clipped to [0.4, 1.0]\n","q_sub = np.clip(rng.normal(SUB_AXIS_RATIO_MEAN, SUB_AXIS_RATIO_SIG, N_SUBHALOS), 0.4, 1.0)\n","pa_sub_deg = rng.uniform(0.0, 180.0, N_SUBHALOS)\n","\n","for xs, ys, rs, ks, q, pa in zip(x_sub_arc, y_sub_arc, RS_sub, KAPPA_S_sub, q_sub, pa_sub_deg):\n","    add_elliptical_nfw(\n","        kappa_total,\n","        x0_arcsec=xs,\n","        y0_arcsec=ys,\n","        rs_arcsec=rs,\n","        kappa_s=ks,\n","        axis_ratio=q,\n","        pa_deg=pa,\n","    )\n","\n","# optional: zero everything beyond 1.3 * R200_MAIN to keep map compact\n","R_tot_arc = np.sqrt(dx_arc**2 + dy_arc**2)\n","kappa_total[R_tot_arc > 1.3 * R200_MAIN_ARCSEC] = 0.0\n","\n","# ------------------------------------------------\n","# build WCS and write FITS\n","# ------------------------------------------------\n","w = WCS(naxis=2)\n","w.wcs.crpix = [cx + 1.0, cy + 1.0]\n","w.wcs.crval = [0.0, 0.0]\n","pix_scale_deg = PIX_SCALE_ARCSEC / 3600.0\n","w.wcs.cdelt = np.array([-pix_scale_deg, pix_scale_deg])\n","w.wcs.ctype = [\"RA---TAN\", \"DEC--TAN\"]\n","\n","hdr = w.to_header()\n","hdr[\"BUNIT\"] = \"dimensionless\"\n","hdr[\"COMMENT\"] = \"Synthetic LCDM-like cluster kappa map (main+second+subhalos).\"\n","\n","hdu = fits.PrimaryHDU(data=kappa_total.astype(np.float32), header=hdr)\n","hdul = fits.HDUList([hdu])\n","hdul.writeto(MOCK_FILENAME, overwrite=True)\n","\n","print(\"Written synthetic kappa map with main+second+subhalos to:\")\n","print(MOCK_FILENAME)\n","\n","# ------------------------------------------------\n","# register in MOCK_OPTIONS so it can be used by profile_with_angular_bins\n","# ------------------------------------------------\n","MOCK_OPTIONS = {\n","    1: dict(\n","        TAG=\"LCDM_MOCK_CLUSTER_2HALO_SUB\",\n","        z=0.4,\n","        kappa=MOCK_FILENAME,\n","        RA=\"00:00:00.0\",\n","        DEC=\"+00:00:00.0\",\n","    )\n","}\n","\n","print(\"Registered MOCK_OPTIONS[1] with TAG =\", MOCK_OPTIONS[1][\"TAG\"])\n"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"AkR4JhH-0lnY","executionInfo":{"status":"ok","timestamp":1765312466153,"user_tz":0,"elapsed":10353,"user":{"displayName":"Jon Axworthy","userId":"03410905867559825123"}},"outputId":"e0b70a0c-40fd-4845-dea9-ab272d96aa18"},"execution_count":89,"outputs":[{"output_type":"stream","name":"stdout","text":["Written synthetic kappa map with main+second+subhalos to:\n","/content/drive/MyDrive/grtt/grtt_source_data/mocks/lcdm_mock_cluster_main2nd_subhalos_kappa.fits\n","Registered MOCK_OPTIONS[1] with TAG = LCDM_MOCK_CLUSTER_2HALO_SUB\n"]}]},{"cell_type":"markdown","source":["### set up and plot cells"],"metadata":{"id":"PBgktp152WWC"}},{"cell_type":"code","source":["# Cell: profile_with_angular_bins for mock maps (centre = WCS reference pixel)\n","\n","def profile_with_angular_bins_mock_center(kappa_path, team_label):\n","    \"\"\"\n","    Compute κ(R), curvature, and shoulder for a kappa map, using the\n","    WCS reference pixel (CRPIX) as the centre.\n","\n","    Intended for synthetic LCDM mocks where the absolute RA/DEC is arbitrary.\n","    \"\"\"\n","    # load map\n","    hdul = fits.open(kappa_path)\n","    data = hdul[0].data\n","    hdr  = hdul[0].header\n","    hdul.close()\n","\n","    w = WCS(hdr)\n","    pixscale = pixel_scale_arcsec(hdr)  # your existing helper\n","\n","    # centre in pixels: use CRPIX (1-based in FITS, convert to 0-based)\n","    cx = float(hdr[\"CRPIX1\"] - 1.0)\n","    cy = float(hdr[\"CRPIX2\"] - 1.0)\n","\n","    ny, nx = data.shape\n","    yy, xx = np.indices(data.shape)\n","    r_pix = np.sqrt((xx - cx)**2 + (yy - cy)**2)\n","\n","    # masks\n","    valid = np.ones_like(data, dtype=bool)\n","    if MASK_NAN:\n","        valid &= ~np.isnan(data)\n","    if MASK_ZERO:\n","        valid &= (data != 0.0)\n","\n","    # angular bin edges (same global config)\n","    if BIN_SPACING == \"linear\":\n","        edges_arc = np.linspace(ANG_R_INNER, ANG_R_OUTER, N_BINS + 1)\n","    else:\n","        edges_arc = np.logspace(np.log10(ANG_R_INNER),\n","                                np.log10(ANG_R_OUTER),\n","                                N_BINS + 1)\n","\n","    # convert to pixels for this map\n","    edges_pix = edges_arc / pixscale\n","    mids_arc  = 0.5 * (edges_arc[:-1] + edges_arc[1:])\n","\n","    rows = []\n","    for (rmin_pix, rmax_pix, rmid_arc) in zip(edges_pix[:-1], edges_pix[1:], mids_arc):\n","        ann = (r_pix >= rmin_pix) & (r_pix < rmax_pix)\n","        tot = ann.sum()\n","        if tot == 0:\n","            rows.append(dict(R_arcsec=rmid_arc,\n","                             kappa_mean=np.nan,\n","                             valid_fraction=0.0,\n","                             use_bin=False))\n","            continue\n","        good = ann & valid\n","        N_valid = good.sum()\n","        if N_valid == 0:\n","            rows.append(dict(R_arcsec=rmid_arc,\n","                             kappa_mean=np.nan,\n","                             valid_fraction=0.0,\n","                             use_bin=False))\n","            continue\n","        vals = data[good]\n","        kmean = float(vals.mean())\n","        vfrac = N_valid / tot\n","        rows.append(dict(\n","            R_arcsec=rmid_arc,\n","            kappa_mean=kmean,\n","            valid_fraction=vfrac,\n","            use_bin=(vfrac >= MIN_VALID_FRACTION),\n","        ))\n","\n","    df = pd.DataFrame(rows)\n","    usable = df[\"use_bin\"]\n","    R_arc = df.loc[usable, \"R_arcsec\"].values\n","    kappa_mean = df.loc[usable, \"kappa_mean\"].values\n","\n","    # RAW curvature\n","    dk  = np.gradient(kappa_mean, R_arc)\n","    d2k = np.gradient(dk, R_arc)\n","\n","    # shoulder: RAW curvature minimum in [SHOULDER_RMIN, SHOULDER_RMAX]\n","    mask_win = (R_arc >= SHOULDER_RMIN) & (R_arc <= SHOULDER_RMAX)\n","    Rw = R_arc[mask_win]\n","    cw = d2k[mask_win]\n","    if len(Rw) >= 3:\n","        idx = np.argmin(cw)\n","        R_sh = float(Rw[idx])\n","    else:\n","        R_sh = np.nan\n","\n","    return dict(\n","        team=team_label,\n","        R_arcsec=R_arc,\n","        kappa_mean=kappa_mean,\n","        d2k=d2k,\n","        R_sh=R_sh,\n","        pixscale=pixscale,\n","    )\n"],"metadata":{"id":"PYmR4h5Z0u5S","executionInfo":{"status":"ok","timestamp":1765313051827,"user_tz":0,"elapsed":22,"user":{"displayName":"Jon Axworthy","userId":"03410905867559825123"}}},"execution_count":101,"outputs":[]},{"cell_type":"code","source":["from astropy.io import fits\n","from astropy.wcs import WCS\n","from astropy.coordinates import SkyCoord\n","import astropy.units as u\n","\n","def profile_with_angular_bins_mock_center(kappa_path, team_label):\n","    \"\"\"\n","    Convenience wrapper for synthetic mocks:\n","    use the WCS centre of the map as the lens centre.\n","    \"\"\"\n","    # open map and get WCS + shape\n","    with fits.open(kappa_path) as hdul:\n","        data = hdul[0].data\n","        hdr  = hdul[0].header\n","\n","    w = WCS(hdr)\n","    ny, nx = data.shape\n","\n","    # pixel centre of the grid\n","    cx = (nx - 1) / 2.0\n","    cy = (ny - 1) / 2.0\n","\n","    # convert that pixel centre to world coords\n","    c_world = w.pixel_to_world(cx, cy)\n","\n","    # crucial: convert to strings, not arrays / quantities\n","    ra_str = c_world.ra.to_string(unit=u.hourangle, sep=\":\", pad=True, precision=3)\n","    dec_str = c_world.dec.to_string(unit=u.deg, sep=\":\", alwayssign=True, precision=2)\n","\n","    # hand off to the main pipeline\n","    return profile_with_angular_bins(kappa_path, ra_str, dec_str, team_label)\n"],"metadata":{"id":"adYVSnBY3fTs","executionInfo":{"status":"ok","timestamp":1765313215958,"user_tz":0,"elapsed":52,"user":{"displayName":"Jon Axworthy","userId":"03410905867559825123"}}},"execution_count":104,"outputs":[]},{"cell_type":"code","source":["mock2 = profile_with_angular_bins_mock_center(\n","    MOCK_OPTIONS[1][\"kappa\"],\n","    MOCK_OPTIONS[1][\"TAG\"],\n",")\n","\n","print(\"Mock (main+second+subhalos) R_sh ≈\", mock2[\"R_sh\"], \"arcsec\")\n","\n","plt.figure(figsize=(6,4))\n","plt.plot(mock2[\"R_arcsec\"], mock2[\"d2k\"], \"o-\")\n","plt.axhline(0, color=\"k\", lw=1)\n","if not np.isnan(mock2[\"R_sh\"]):\n","    plt.axvline(mock2[\"R_sh\"], ls=\"--\", color=\"r\")\n","plt.xlabel(\"R (arcsec)\")\n","plt.ylabel(r\"$d^2\\kappa/dR^2$\")\n","plt.title(\"LCDM-like mock (main+second+subhalos): curvature profile\")\n","plt.tight_layout()\n","plt.show()\n"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":424},"id":"j4i0Dy9o3hel","executionInfo":{"status":"ok","timestamp":1765313225268,"user_tz":0,"elapsed":616,"user":{"displayName":"Jon Axworthy","userId":"03410905867559825123"}},"outputId":"23b1de1b-c3a2-4dd4-d642-2fd43636e582"},"execution_count":105,"outputs":[{"output_type":"stream","name":"stdout","text":["Mock (main+second+subhalos) R_sh ≈ 33.0 arcsec\n"]},{"output_type":"display_data","data":{"text/plain":["<Figure size 600x400 with 1 Axes>"],"image/png":"\n"},"metadata":{}}]},{"cell_type":"code","source":["# Cell: LCDM mock ensemble – main halo + second halo + subhalos\n","\n","import numpy as np\n","import pandas as pd\n","from astropy.io import fits\n","from astropy.wcs import WCS\n","import os\n","\n","# ------------------------------------------------------------------\n","# Grid / resolution (keep consistent with earlier mock cell)\n","# ------------------------------------------------------------------\n","NPIX = 1024\n","PIX_SCALE_ARCSEC = 0.06  # arcsec / pixel\n","\n","# Static grid in angular coords\n","y_idx, x_idx = np.indices((NPIX, NPIX))\n","cx = (NPIX - 1) / 2.0\n","cy = (NPIX - 1) / 2.0\n","dx_pix = x_idx - cx\n","dy_pix = y_idx - cy\n","dx_arc = dx_pix * PIX_SCALE_ARCSEC\n","dy_arc = dy_pix * PIX_SCALE_ARCSEC\n","\n","# ------------------------------------------------------------------\n","# NFW helper (same as before)\n","# ------------------------------------------------------------------\n","def kappa_nfw(R_arcsec, rs_arcsec, kappa_s):\n","    x = np.asarray(R_arcsec, dtype=float) / rs_arcsec\n","    k = np.zeros_like(x)\n","    eps = 1e-6\n","    x_safe = np.where(x == 0, eps, x)\n","\n","    mask1 = x_safe < 1.0\n","    if np.any(mask1):\n","        xm = x_safe[mask1]\n","        f = np.arctanh(np.sqrt(1 - xm**2)) / np.sqrt(1 - xm**2)\n","        k[mask1] = 2 * kappa_s * f / (xm**2 - 1)\n","\n","    mask2 = np.isclose(x_safe, 1.0, atol=1e-4)\n","    if np.any(mask2):\n","        k[mask2] = 2 * kappa_s / 3.0\n","\n","    mask3 = x_safe > 1.0\n","    if np.any(mask3):\n","        xp = x_safe[mask3]\n","        f = np.arctan(np.sqrt(xp**2 - 1)) / np.sqrt(xp**2 - 1)\n","        k[mask3] = 2 * kappa_s * f / (xp**2 - 1)\n","\n","    return k\n","\n","def add_elliptical_nfw(kappa_grid,\n","                       x0_arcsec, y0_arcsec,\n","                       rs_arcsec, kappa_s,\n","                       axis_ratio, pa_deg):\n","    \"\"\"\n","    Add an elliptical NFW halo to kappa_grid using the global dx_arc, dy_arc.\n","    (x0_arcsec, y0_arcsec) are offsets from grid centre in arcsec.\n","    \"\"\"\n","    # Shift coordinates\n","    x_rel = dx_arc - x0_arcsec\n","    y_rel = dy_arc - y0_arcsec\n","\n","    # Rotate by PA (deg, CCW from +x)\n","    theta = np.deg2rad(pa_deg)\n","    cos_t, sin_t = np.cos(theta), np.sin(theta)\n","    x_rot =  x_rel * cos_t + y_rel * sin_t\n","    y_rot = -x_rel * sin_t + y_rel * cos_t\n","\n","    # Elliptical radius\n","    R_ell_arc = np.sqrt(x_rot**2 + (y_rot / axis_ratio)**2)\n","\n","    kappa_grid += kappa_nfw(R_ell_arc, rs_arcsec, kappa_s)\n","\n","# ------------------------------------------------------------------\n","# Generate one LCDM-like mock (main + second + subhalos)\n","# ------------------------------------------------------------------\n","def generate_lcdm_mock_map(rng):\n","    # --- main halo ---\n","    R200_main = rng.uniform(220.0, 380.0)  # arcsec\n","    c_main    = rng.uniform(3.0, 6.0)\n","    rs_main   = R200_main / c_main\n","    kappa_s_main = rng.uniform(0.3, 0.6)\n","\n","    q_main  = np.clip(rng.normal(0.75, 0.10), 0.5, 1.0)\n","    pa_main = rng.uniform(-30.0, 30.0)\n","\n","    # --- second halo ---\n","    mass_ratio_second = rng.uniform(0.1, 0.5)\n","    R200_second = R200_main * mass_ratio_second**(1/3)\n","    c_second    = rng.uniform(3.0, 6.0)\n","    rs_second   = R200_second / c_second\n","    kappa_s_second = kappa_s_main * mass_ratio_second**(1/3)\n","\n","    sep_second = rng.uniform(50.0, 140.0)    # arcsec\n","    pa_sep     = rng.uniform(-90.0, 90.0)    # where it sits relative to main\n","\n","    x_off = sep_second * np.cos(np.deg2rad(pa_sep))\n","    y_off = sep_second * np.sin(np.deg2rad(pa_sep))\n","\n","    q_second  = np.clip(rng.normal(0.8, 0.10), 0.5, 1.0)\n","    pa_second = rng.uniform(-45.0, 45.0)\n","\n","    # --- subhalos ---\n","    N_sub = int(rng.integers(30, 90))\n","    R_sub_max = rng.uniform(180.0, 260.0)\n","\n","    u = rng.random(N_sub)\n","    R_sub = R_sub_max * np.sqrt(u)\n","    phi_sub = 2 * np.pi * rng.random(N_sub)\n","    x_sub = R_sub * np.cos(phi_sub)\n","    y_sub = R_sub * np.sin(phi_sub)\n","\n","    rs_sub = 10.0 ** rng.uniform(np.log10(4.0), np.log10(25.0), N_sub)\n","    kappa_s_sub = 10.0 ** rng.uniform(np.log10(0.01), np.log10(0.07), N_sub)\n","    q_sub = np.clip(rng.normal(0.8, 0.15, N_sub), 0.4, 1.0)\n","    pa_sub = rng.uniform(0.0, 180.0, N_sub)\n","\n","    # --- build kappa grid ---\n","    kappa = np.zeros_like(dx_arc, dtype=np.float32)\n","\n","    # main halo\n","    add_elliptical_nfw(kappa, 0.0, 0.0, rs_main, kappa_s_main, q_main, pa_main)\n","\n","    # second halo\n","    add_elliptical_nfw(kappa, x_off, y_off, rs_second, kappa_s_second, q_second, pa_second)\n","\n","    # subhalos\n","    for xs, ys, rs, ks, q, pa in zip(x_sub, y_sub, rs_sub, kappa_s_sub, q_sub, pa_sub):\n","        add_elliptical_nfw(kappa, xs, ys, rs, ks, q, pa)\n","\n","    # truncate far outside main halo (optional)\n","    R_tot = np.sqrt(dx_arc**2 + dy_arc**2)\n","    kappa[R_tot > 1.3 * R200_main] = 0.0\n","\n","    # WCS header\n","    w = WCS(naxis=2)\n","    w.wcs.crpix = [cx + 1.0, cy + 1.0]\n","    w.wcs.crval = [0.0, 0.0]\n","    pix_scale_deg = PIX_SCALE_ARCSEC / 3600.0\n","    w.wcs.cdelt = np.array([-pix_scale_deg, pix_scale_deg])\n","    w.wcs.ctype = [\"RA---TAN\", \"DEC--TAN\"]\n","    hdr = w.to_header()\n","    hdr[\"BUNIT\"] = \"dimensionless\"\n","\n","    return kappa, hdr, dict(\n","        R200_main=R200_main,\n","        c_main=c_main,\n","        mass_ratio_second=mass_ratio_second,\n","        N_sub=N_sub,\n","    )\n","\n","# ------------------------------------------------------------------\n","# Ensemble loop (WARNING: can be slow for large N_MOCKS)\n","# ------------------------------------------------------------------\n","MOCK_SUBDIR = f\"{BASE_PATH}mocks/\"\n","os.makedirs(MOCK_SUBDIR, exist_ok=True)\n","\n","N_MOCKS = 80   # reduce if runtime is an issue\n","rng = np.random.default_rng(2025)\n","\n","rows = []\n","\n","for i in range(N_MOCKS):\n","    kappa_map, hdr, meta = generate_lcdm_mock_map(rng)\n","    mock_path = os.path.join(MOCK_SUBDIR, f\"lcdm_mock_{i:03d}.fits\")\n","\n","    # write FITS for reuse / inspection\n","    hdu = fits.PrimaryHDU(data=kappa_map.astype(np.float32), header=hdr)\n","    fits.HDUList([hdu]).writeto(mock_path, overwrite=True)\n","\n","    # curvature operator using WCS-centre version\n","    prof = profile_with_angular_bins_mock_center(mock_path, f\"LCDM_MOCK_{i}\")\n","\n","    R = prof[\"R_arcsec\"]\n","    c = prof[\"d2k\"]\n","\n","    # search for local minima in the 20–80\" window\n","    w = (R >= SHOULDER_RMIN) & (R <= SHOULDER_RMAX)\n","    Rw = R[w]\n","    cw = c[w]\n","\n","    n_min = 0\n","    R_sh1 = np.nan\n","    R_sh2 = np.nan\n","\n","    if len(Rw) >= 3:\n","        # internal points that are lower than neighbours\n","        is_min = np.r_[\n","            False,\n","            (cw[1:-1] < cw[:-2]) & (cw[1:-1] < cw[2:]),\n","            False,\n","        ]\n","        R_mins = Rw[is_min]\n","        c_mins = cw[is_min]\n","\n","        if len(R_mins) > 0:\n","            # sort by depth (more negative first)\n","            order = np.argsort(c_mins)\n","            R_mins = R_mins[order]\n","            c_mins = c_mins[order]\n","            n_min = len(R_mins)\n","            R_sh1 = R_mins[0]\n","            # treat as distinct second minimum only if separated by >= 10\"\n","            if n_min >= 2 and np.abs(R_mins[1] - R_mins[0]) >= 10.0:\n","                R_sh2 = R_mins[1]\n","            else:\n","                if n_min >= 2:\n","                    n_min = 1  # effectively one broad minimum\n","\n","    rows.append(dict(\n","        mock_id=i,\n","        R200_main_arcsec=meta[\"R200_main\"],\n","        c_main=meta[\"c_main\"],\n","        mass_ratio_second=meta[\"mass_ratio_second\"],\n","        N_sub=meta[\"N_sub\"],\n","        R_sh1_arcsec=R_sh1,\n","        R_sh2_arcsec=R_sh2,\n","        n_minima=n_min,\n","    ))\n","\n","df_mocks = pd.DataFrame(rows)\n","print(df_mocks.head())\n","\n","print(\"\\nCounts of number of curvature minima (20–80\\\") per mock:\")\n","print(df_mocks[\"n_minima\"].value_counts().sort_index())\n","\n","print(\"\\nR_sh1 (deepest minimum) summary for mocks with at least one minimum:\")\n","print(df_mocks.loc[df_mocks[\"n_minima\"] >= 1, \"R_sh1_arcsec\"].describe())\n","\n","df_mocks\n"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":961},"id":"BRWEqM7o758l","executionInfo":{"status":"ok","timestamp":1765314890388,"user_tz":0,"elapsed":515670,"user":{"displayName":"Jon Axworthy","userId":"03410905867559825123"}},"outputId":"dafa71e6-8dda-4290-e686-f0d502f84ddf"},"execution_count":106,"outputs":[{"output_type":"stream","name":"stdout","text":["   mock_id  R200_main_arcsec    c_main  mass_ratio_second  N_sub  \\\n","0        0        379.113249  4.146029           0.130890     57   \n","1        1        351.224914  3.737012           0.252199     43   \n","2        2        322.503430  5.010867           0.310639     52   \n","3        3
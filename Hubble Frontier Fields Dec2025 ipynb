F2zoKzRCme"}},{"cell_type":"code","source":["# Cell: reusable 3-panel κ–map plotter with shoulders overplotted\n","\n","import numpy as np\n","import matplotlib.pyplot as plt\n","from matplotlib.patches import Circle\n","from astropy.io import fits\n","from astropy.wcs import WCS\n","from astropy.coordinates import SkyCoord\n","import astropy.units as u\n","from astropy.visualization import ZScaleInterval, ImageNormalize, LogStretch, AsinhStretch, PercentileInterval\n","\n","def plot_cluster_panels(cluster_name):\n","    \"\"\"\n","    Plot a 3-panel κ–map figure (CATS / GLAFIC / SHARON) for one HFF cluster,\n","    with all three shoulder radii overplotted in each panel.\n","\n","    Requirements:\n","      - `results_df` must contain this cluster with columns:\n","          ['cluster','team','RA_center','DEC_center','R_sh_arcsec']\n","      - `HFF_OPTIONS` and `pixel_scale_arcsec` must be defined.\n","    \"\"\"\n","    # Subset of results for this cluster\n","    df_cl = results_df[results_df[\"cluster\"] == cluster_name]\n","    if df_cl.empty:\n","        raise ValueError(f\"No entries for cluster '{cluster_name}' in results_df\")\n","\n","    shoulders_arcsec = {row[\"team\"]: row[\"R_sh_arcsec\"] for _, row in df_cl.iterrows()}\n","    max_R = df_cl[\"R_sh_arcsec\"].max()\n","\n","    # RA/DEC centre actually used (from consolidated table)\n","    ra_str  = df_cl[\"RA_center\"].iloc[0]\n","    dec_str = df_cl[\"DEC_center\"].iloc[0]\n","\n","    # TAGs used in HFF_OPTIONS and short labels for panel titles\n","    teams = [\n","        (f\"{cluster_name}_CATS\",   \"CATS\"),\n","        (f\"{cluster_name}_GLAFIC\", \"GLAFIC\"),\n","        (f\"{cluster_name}_SHARON\", \"SHARON\"),\n","    ]\n","\n","    fig, axes = plt.subplots(1, 3, figsize=(15, 5))\n","\n","    for ax, (tag, label) in zip(axes, teams):\n","        # Find matching HFF_OPTIONS entry by TAG\n","        opt = next(v for v in HFF_OPTIONS.values() if v[\"TAG\"] == tag)\n","        kappa_path = opt[\"kappa\"]\n","\n","        # Load κ-map\n","        hdul = fits.open(kappa_path)\n","        kappa = hdul[0].data\n","        hdr   = hdul[0].header\n","        hdul.close()\n","\n","        w = WCS(hdr)\n","        pix_scale_arcsec = pixel_scale_arcsec(hdr)\n","\n","        # Centre in pixels\n","        coord_c = SkyCoord(ra_str, dec_str, unit=(u.hourangle, u.deg))\n","        x0, y0 = w.all_world2pix([[coord_c.ra.deg, coord_c.dec.deg]], 0)[0]\n","        x0, y0 = float(x0), float(y0)\n","\n","        # Zoom window: 3 × max shoulder radius\n","        zoom_radius_pix = 3.0 * (max_R / pix_scale_arcsec)\n","        ny, nx = kappa.shape\n","        x_min = max(0, int(x0 - zoom_radius_pix))\n","        x_max = min(nx, int(x0 + zoom_radius_pix))\n","        y_min = max(0, int(y0 - zoom_radius_pix))\n","        y_max = min(ny, int(y0 + zoom_radius_pix))\n","        kappa_zoom = kappa[y_min:y_max, x_min:x_max]\n","\n","        # Image scaling: viridis + asinh stretch with percentile interval\n","        finite_vals = kappa_zoom[np.isfinite(kappa_zoom)]\n","        if finite_vals.size == 0:\n","            raise RuntimeError(f\"No finite κ values in zoom window for {tag}\")\n","        interval = PercentileInterval(99.5)\n","        stretch  = AsinhStretch()\n","        norm = ImageNormalize(kappa_zoom, interval=interval, stretch=stretch)\n","        ax.imshow(kappa_zoom, origin=\"lower\", cmap=\"viridis\", norm=norm)\n","\n","        # Contours\n","        vmin = np.percentile(finite_vals, 40)\n","        vmax = np.percentile(finite_vals, 98)\n","        levels = np.linspace(vmin, vmax, 7)\n","        ax.contour(kappa_zoom, levels=levels, colors=\"white\", linewidths=0.5, alpha=0.6)\n","\n","        # Centre crosshair in zoomed coordinates\n","        x0_zoom = x0 - x_min\n","        y0_zoom = y0 - y_min\n","        ax.axhline(y0_zoom, color=\"white\", alpha=0.4, linewidth=0.7)\n","        ax.axvline(x0_zoom, color=\"white\", alpha=0.4, linewidth=0.7)\n","\n","        # Shoulder circles for all three reconstructions.\n","        # Small pixel-scale offsets (±Δr) are applied for plotting only,\n","        # so overlapping shoulders remain visually distinct.\n","        circle_styles = [\n","            (f\"{cluster_name}_CATS\",   \"#ff5555\", 1.6, -1.5),  # red\n","            (f\"{cluster_name}_GLAFIC\", \"#ffffff\", 1.2,  0.0),  # white\n","            (f\"{cluster_name}_SHARON\", \"#00e5ff\", 1.6, +1.5),  # cyan\n","        ]\n","\n","        for team_full, color, lw, dr_pix in circle_styles:\n","            R_sh_arcsec = shoulders_arcsec[team_full]\n","            R_sh_pix    = R_sh_arcsec / pix_scale_arcsec\n","            circ = Circle(\n","                (x0_zoom, y0_zoom),\n","                R_sh_pix + dr_pix,  # tiny offset for visibility only\n","                edgecolor=color,\n","                facecolor=\"none\",\n","                linestyle=\"--\",\n","                linewidth=lw,\n","                alpha=0.9,\n","            )\n","            ax.add_patch(circ)\n","\n","        ax.set_title(f\"{cluster_name} {label}\", fontsize=12)\n","        ax.set_xlabel(\"Pixel X (zoomed)\")\n","        if ax is axes[0]:\n","            ax.set_ylabel(\"Pixel Y (zoomed)\")\n","        ax.set_aspect(\"equal\")\n","\n","    # Shared legend for shoulders\n","    circle_handles = [\n","        plt.Line2D([0], [0], color=\"#ff5555\", linestyle=\"--\", linewidth=1.6, label=\"CATS shoulder\"),\n","        plt.Line2D([0], [0], color=\"#ffffff\", linestyle=\"--\", linewidth=1.2, label=\"GLAFIC shoulder\"),\n","        plt.Line2D([0], [0], color=\"#00e5ff\", linestyle=\"--\", linewidth=1.6, label=\"SHARON shoulder\"),\n","    ]\n","\n","    fig.legend(\n","        handles=circle_handles,\n","        loc=\"lower center\",\n","        ncol=3,\n","        bbox_to_anchor=(0.5, -0.05),\n","        frameon=False,\n","        fontsize=11,\n","    )\n","\n","    plt.tight_layout()\n","    plt.show()\n","\n","# Example usage:\n","# plot_cluster_panels(\"ABELL2744\")\n","# plot_cluster_panels(\"MACS0416\")\n","# plot_cluster_panels(\"MACS0717\")\n","# plot_cluster_panels(\"MACS1149\")\n","# plot_cluster_panels(\"ABELLS1063\")\n","plot_cluster_panels(\"ABELL370\")\n"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":440},"id":"BWgGqGGzd7ZZ","executionInfo":{"status":"ok","timestamp":1765291656845,"user_tz":0,"elapsed":26250,"user":{"displayName":"Jon Axworthy","userId":"03410905867559825123"}},"outputId":"3ba7d6c9-bf50-41c3-add0-78b47624f990"},"execution_count":18,"outputs":[{"output_type":"display_data","data":{"text/plain":["<Figure size 1500x500 with 3 Axes>"],"image/png":"\n"},"metadata":{}}]},{"cell_type":"code","source":["# Cell: Radial Convergence Profiles – full HFF ensemble (all 18 reconstructions)\n","\n","import numpy as np\n","import matplotlib.pyplot as plt\n","\n","# Assumes already defined:\n","#   - HFF_OPTIONS\n","#   - results_df with: cluster, team, RA_center, DEC_center, R_sh_arcsec\n","#   - profile_with_angular_bins(kappa_path, ra_str, dec_str, team_label)\n","\n","profiles = []          # list of dicts: {cluster, team, r_norm, k_norm, r_sh_norm}\n","r_sh_norm_list = []    # to compute ensemble median shoulder radius\n","colors = plt.rcParams['axes.prop_cycle'].by_key()['color']\n","\n","for _, row in results_df.iterrows():\n","    cluster     = row[\"cluster\"]\n","    team_tag    = row[\"team\"]              # e.g. \"MACS1149_CATS\"\n","    R_sh_arcsec = float(row[\"R_sh_arcsec\"])\n","    ra_str      = row[\"RA_center\"]\n","    dec_str     = row[\"DEC_center\"]\n","\n","    # find kappa path from HFF_OPTIONS\n","    opt = next(v for v in HFF_OPTIONS.values() if v[\"TAG\"] == team_tag)\n","    kappa_path = opt[\"kappa\"]\n","\n","    # compute radial profile (angular-binned, RAW curvature pipeline)\n","    prof = profile_with_angular_bins(kappa_path, ra_str, dec_str, team_tag)\n","    R_arc = np.asarray(prof[\"R_arcsec\"])\n","    kappa_mean = np.asarray(prof[\"kappa_mean\"])\n","\n","    # keep only finite bins\n","    mask = np.isfinite(R_arc) & np.isfinite(kappa_mean)\n","    if not np.any(mask):\n","        continue\n","\n","    R_arc = R_arc[mask]\n","    kappa_mean = kappa_mean[mask]\n","\n","    # sort by radius just in case\n","    order = np.argsort(R_arc)\n","    R_arc = R_arc[order]\n","    kappa_mean = kappa_mean[order]\n","\n","    # define r_max for this map and normalise radius\n","    r_max = R_arc.max()\n","    if r_max <= 0:\n","        continue\n","    r_norm = R_arc / r_max\n","\n","    # normalise κ so that innermost valid bin is 1\n","    k0 = kappa_mean[0]\n","    if k0 == 0:\n","        # if the very first bin is zero (unlikely with our masks), skip this map\n","        continue\n","    k_norm = kappa_mean / k0\n","\n","    # normalised shoulder radius for this map\n","    r_sh_norm = R_sh_arcsec / r_max\n","    r_sh_norm_list.append(r_sh_norm)\n","\n","    profiles.append(dict(\n","        cluster=cluster,\n","        team=team_tag,\n","        r_norm=r_norm,\n","        k_norm=k_norm,\n","        r_sh_norm=r_sh_norm,\n","    ))\n","\n","# common r-grid for ensemble statistics\n","r_grid = np.linspace(0.0, 1.0, 80)\n","\n","# interpolate each profile onto the common grid\n","k_interp_all = []\n","for prof in profiles:\n","    r = prof[\"r_norm\"]\n","    k = prof[\"k_norm\"]\n","    k_interp = np.interp(r_grid, r, k)\n","    k_interp_all.append(k_interp)\n","\n","k_interp_all = np.array(k_interp_all)  # shape: (N_profiles, N_grid)\n","k_mean = np.mean(k_interp_all, axis=0)\n","k_std  = np.std(k_interp_all, axis=0)\n","\n","# ensemble median shoulder radius in r/r_max units\n","r_sh_med = np.median(r_sh_norm_list)\n","\n","# --- plot ---\n","fig, ax = plt.subplots(figsize=(8, 6))\n","\n","# plot each individual profile\n","for i, prof in enumerate(profiles):\n","    col = colors[i % len(colors)]\n","    label = prof[\"team\"]\n","    ax.plot(prof[\"r_norm\"], prof[\"k_norm\"], lw=0.8, alpha=0.9, label=label)\n","\n","# ±1σ band\n","ax.fill_between(\n","    r_grid, k_mean - k_std, k_mean + k_std,\n","    color=\"0.8\", alpha=0.7, label=\"±1σ scatter\"\n",")\n","\n","# mean profile\n","ax.plot(r_grid, k_mean, color=\"k\", lw=2.0, label=\"Mean profile\")\n","\n","# median shoulder radius\n","ax.axvline(r_sh_med, color=\"grey\", lw=1.5, ls=\"--\",\n","           label=f\"Median shoulder radius (r/r_max ≈ {r_sh_med:.2f})\")\n","\n","ax.set_xlim(0.0, 1.0)\n","ax.set_ylim(bottom=0.0)\n","\n","ax.set_xlabel(r\"Normalised radius  $r/r_{\\max}$\")\n","ax.set_ylabel(r\"Normalised $\\kappa / \\kappa_0$\")\n","ax.set_title(\"Radial Convergence Profiles — Full HFF Reconstruction Ensemble\")\n","\n","ax.grid(alpha=0.3)\n","ax.legend(fontsize=6, ncol=2, frameon=True)\n","\n","plt.tight_layout()\n","plt.show()\n"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":607},"id":"RE7Z-lS0mdwG","executionInfo":{"status":"ok","timestamp":1765292066766,"user_tz":0,"elapsed":90429,"user":{"displayName":"Jon Axworthy","userId":"03410905867559825123"}},"outputId":"df98573d-ceaa-41ec-f258-b3194f8b691f"},"execution_count":19,"outputs":[{"output_type":"display_data","data":{"text/plain":["<Figure size 800x600 with 1 Axes>"],"image/png":"\n"},"metadata":{}}]},{"cell_type":"code","source":["# Cell: stacked κ(R) and curvature for all 3 teams in one cluster\n","\n","import numpy as np\n","import matplotlib.pyplot as plt\n","\n","def plot_cluster_profiles_and_curvature(cluster_name,\n","                                        R_min_plot=20.0,\n","                                        R_max_plot=120.0):\n","    \"\"\"\n","    For one HFF cluster (e.g. 'MACS1149'), plot:\n","      - κ(R) for CATS / GLAFIC / SHARON\n","      - d²κ/dR² for CATS / GLAFIC / SHARON\n","    using the same radial-binning pipeline and shoulders from results_df.\n","    \"\"\"\n","\n","    # subset results for this cluster\n","    df_cl = results_df[results_df[\"cluster\"] == cluster_name]\n","    if df_cl.empty:\n","        raise ValueError(f\"No entries for cluster '{cluster_name}' in results_df\")\n","\n","    # RA/DEC centre (same for all teams within a cluster)\n","    ra_str  = df_cl[\"RA_center\"].iloc[0]\n","    dec_str = df_cl[\"DEC_center\"].iloc[0]\n","\n","    # define ordering and colours per team\n","    teams = [\n","        (f\"{cluster_name}_CATS\",   \"CATS\"),\n","        (f\"{cluster_name}_GLAFIC\", \"GLAFIC\"),\n","        (f\"{cluster_name}_SHARON\", \"SHARON\"),\n","    ]\n","    color_map = {\n","        \"CATS\":   \"#ff5555\",  # red\n","        \"GLAFIC\": \"#1f77b4\",  # blue\n","        \"SHARON\": \"#2ca02c\",  # green\n","    }\n","\n","    # collect profiles\n","    profs = []\n","    for tag, short_label in teams:\n","        # shoulder radius for this team\n","        sel = (df_cl[\"team\"] == tag)\n","        if not sel.any():\n","            continue  # should not happen, but be safe\n","\n","        R_sh = float(df_cl.loc[sel, \"R_sh_arcsec\"].iloc[0])\n","\n","        # kappa path\n","        opt = next(v for v in HFF_OPTIONS.values() if v[\"TAG\"] == tag)\n","        kappa_path = opt[\"kappa\"]\n","\n","        # radial profile via main pipeline\n","        prof = profile_with_angular_bins(kappa_path, ra_str, dec_str, tag)\n","        R_arc   = np.asarray(prof[\"R_arcsec\"])\n","        k_mean  = np.asarray(prof[\"kappa_mean\"])\n","\n","        mask = np.isfinite(R_arc) & np.isfinite(k_mean)\n","        R_arc  = R_arc[mask]\n","        k_mean = k_mean[mask]\n","\n","        order = np.argsort(R_arc)\n","        R_arc  = R_arc[order]\n","        k_mean = k_mean[order]\n","\n","        pmask = (R_arc >= R_min_plot) & (R_arc <= R_max_plot)\n","        R_arc_plot  = R_arc[pmask]\n","        k_mean_plot = k_mean[pmask]\n","\n","        # derivatives\n","        dkdR   = np.gradient(k_mean_plot, R_arc_plot)\n","        d2kdR2 = np.gradient(dkdR, R_arc_plot)\n","\n","        profs.append(dict(\n","            tag=tag,\n","            label=short_label,\n","            R_arc=R_arc_plot,\n","            k_mean=k_mean_plot,\n","            d2kdR2=d2kdR2,\n","            R_sh=R_sh,\n","        ))\n","\n","    if not profs:\n","        raise RuntimeError(f\"No usable profiles for cluster '{cluster_name}'\")\n","\n","    # --- plot ---\n","\n","    fig, (ax1, ax2) = plt.subplots(2, 1, figsize=(7, 7), sharex=True)\n","\n","    # κ(R) panel\n","    for p in profs:\n","        col = color_map[p[\"label\"]]\n","        ax1.plot(p[\"R_arc\"], p[\"k_mean\"], lw=1.5, color=col, label=f\"{p['label']} κ(R)\")\n","        ax1.axvline(p[\"R_sh\"], color=col, ls=\"--\", lw=1.0, alpha=0.8)\n","\n","    ax1.set_ylabel(r\"$\\kappa(R)$\")\n","    ax1.set_title(f\"{cluster_name}: κ(R) and curvature (CATS / GLAFIC / SHARON)\")\n","    ax1.grid(alpha=0.3)\n","    ax1.legend(fontsize=8, frameon=True)\n","\n","    # d²κ/dR² panel\n","    for p in profs:\n","        col = color_map[p[\"label\"]]\n","        ax2.plot(\n","            p[\"R_arc\"],\n","            p[\"d2kdR2\"],\n","            lw=1.5,\n","            color=col,\n","            label=f\"{p['label']} \" + r\"$d^2\\kappa/dR^2$\",\n","        )\n","        ax2.axvline(p[\"R_sh\"], color=col, ls=\"--\", lw=1.0, alpha=0.8)\n","\n","    ax2.axhline(0.0, color=\"k\", lw=0.8, alpha=0.5)\n","    ax2.set_xlabel(r\"$R\\ {\\rm (arcsec)}$\")\n","    ax2.set_ylabel(r\"$d^2\\kappa/dR^2$\")\n","    ax2.grid(alpha=0.3)\n","    ax2.legend(fontsize=8, frameon=True)\n","\n","    plt.tight_layout()\n","    plt.show()\n","\n","\n","# Example usage:\n","# plot_cluster_profiles_and_curvature(\"ABELL2744\")\n","# plot_cluster_profiles_and_curvature(\"MACS0416\")\n","# plot_cluster_profiles_and_curvature(\"MACS0717\")\n","# plot_cluster_profiles_and_curvature(\"MACS1149\")\n","# plot_cluster_profiles_and_curvature(\"ABELLS1063\")\n","plot_cluster_profiles_and_curvature(\"ABELL370\")\n"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":707},"id":"qkZ-s2latNnK","executionInfo":{"status":"ok","timestamp":1765294956246,"user_tz":0,"elapsed":13751,"user":{"displayName":"Jon Axworthy","userId":"03410905867559825123"}},"outputId":"9a07b75f-e0ff-4070-dae6-24d3a62159bc"},"execution_count":50,"outputs":[{"output_type":"display_data","data":{"text/plain":["<Figure size 700x700 with 2 Axes>"],"image/png":"\n"},"metadata":{}}]},{"cell_type":"markdown","source":["#Safety Checks"],"metadata":{"id":"qSNR11eE4HCq"}},{"cell_type":"code","source":["# Cell: Robust shifted-centre null test on Abell 2744 HFF parallel F814W\n","# -------------------------------------------------------------------\n","# Usage examples (edit dx, dy as needed):\n","# run_parallel_null_test(dx=-580, dy=-400)\n","run_parallel_null_test(dx=0,   dy=0)\n","\n","import numpy as np\n","import matplotlib.pyplot as plt\n","from astropy.io import fits\n","from matplotlib.patches import Circle\n","\n","# Parallel field image (Abell 2744 HFF F814W)\n","NULL_PATH = (\n","    \"/content/drive/MyDrive/grtt/grtt_source_data/stronglensing/\"\n","    \"hlsp_frontier_hst_acs-30mas_abell2744-hffpar_f814w_v1.0_drz.fits\"\n",")\n","\n","def pixel_scale_arcsec_parallel(hdr):\n","    \"\"\"Pixel scale in arcsec/px for the parallel field (prefer CD matrix).\"\"\"\n","    if \"CD1_1\" in hdr and \"CD2_2\" in hdr:\n","        sx = np.abs(hdr[\"CD1_1\"]) * 3600.0\n","        sy = np.abs(hdr[\"CD2_2\"]) * 3600.0\n","    elif \"CDELT1\" in hdr and \"CDELT2\" in hdr:\n","        sx = np.abs(hdr[\"CDELT1\"]) * 3600.0\n","        sy = np.abs(hdr[\"CDELT2\"]) * 3600.0\n","    else:\n","        raise RuntimeError(\"No CD/CDELT keys for pixel scale in parallel header.\")\n","    return 0.5 * (sx + sy)\n","\n","def run_parallel_null_test(dx=0, dy=0, R_max_arc=120.0, N_bins=40):\n","    \"\"\"\n","    Shifted-centre null test on the Abell 2744 HFF parallel F814W image.\n","\n","    Parameters\n","    ----------\n","    dx, dy : float\n","        Shift of the assumed centre in PIXELS (image coordinates).\n","        +x is right, +y is up.\n","    R_max_arc : float\n","        Maximum radius (arcsec) for the cropped box and profile.\n","    N_bins : int\n","        Number of radial bins between 0 and R_max_arc.\n","    \"\"\"\n","\n","    # -----------------------------------------------------------------\n","    # 1. Load image and basic geometry\n","    # -----------------------------------------------------------------\n","    with fits.open(NULL_PATH, memmap=True) as hdul:\n","        hdr = hdul[0].header\n","        img = hdul[0].data.astype(np.float32)\n","\n","    ny, nx = img.shape\n","\n","    # pixel scale in arcsec / pixel (parallel-specific helper)\n","    pix_scale = pixel_scale_arcsec_parallel(hdr)\n","\n","    # original geometric centre\n","    x0 = (nx - 1) / 2.0\n","    y0 = (ny - 1) / 2.0\n","\n","    # shifted centre\n","    x0s = x0 + dx\n","    y0s = y0 + dy\n","\n","    print(f\"Image size: {nx} x {ny} px, pixel scale = {pix_scale:.4f} arcsec/px\")\n","    print(f\"Shifted centre: x0={x0s:.1f}, y0={y0s:.1f}  (dx={dx}, dy={dy})\")\n","\n","    # -----------------------------------------------------------------\n","    # 2. Define a cropped box out to R_max_arc from the shifted centre\n","    # -----------------------------------------------------------------\n","    R_max_pix = int(R_max_arc / pix_scale)\n","\n","    x_min = int(max(0, x0s - R_max_pix))\n","    x_max = int(min(nx, x0s + R_max_pix))\n","    y_min = int(max(0, y0s - R_max_pix))\n","    y_max = int(min(ny, y0s + R_max_pix))\n","\n","    sub = img[y_min:y_max, x_min:x_max]\n","\n","    # shifted centre in subimage coordinates\n","    ny_sub, nx_sub = sub.shape\n","    x0_sub = x0s - x_min\n","    y0_sub = y0s - y_min\n","\n","    # -----------------------------------------------------------------\n","    # 3. Build radial profile and curvature in the cropped box\n","    # -----------------------------------------------------------------\n","    y_idx, x_idx = np.indices(sub.shape, dtype=np.float32)\n","    r_pix = np.sqrt((x_idx - x0_sub)**2 + (y_idx - y0_sub)**2)\n","    r_arc = r_pix * pix_scale\n","\n","    valid = np.isfinite(sub)\n","    r_arc_v = r_arc[valid].ravel()\n","    I_v     = sub[valid].ravel()\n","\n","    R_min_arc = 0.0\n","    bins = np.linspace(R_min_arc, R_max_arc, N_bins + 1)\n","    centres = 0.5 * (bins[:-1] + bins[1:])\n","\n","    I_mean = np.zeros(N_bins, dtype=np.float64)\n","    counts = np.zeros(N_bins, dtype=int)\n","\n","    for i in range(N_bins):\n","        m = (r_arc_v >= bins[i]) & (r_arc_v < bins[i+1])\n","        if np.any(m):\n","            vals = I_v[m]\n","            I_mean[i] = np.mean(vals)\n","            counts[i] = m.sum()\n","        else:\n","            I_mean[i] = np.nan\n","\n","    mask_prof = (counts > 0) & np.isfinite(I_mean)\n","    if not np.any(mask_prof):\n","        print(\"No valid radial bins; nothing to analyse.\")\n","        return\n","\n","    R_arc_prof = centres[mask_prof]\n","    I_prof     = I_mean[mask_prof]\n","\n","    if R_arc_prof.size < 3:\n","        print(\"Too few radial bins for a curvature estimate.\")\n","        return\n","\n","    order       = np.argsort(R_arc_prof)\n","    R_arc_prof  = R_arc_prof[order]\n","    I_prof      = I_prof[order]\n","\n","    dIdR   = np.gradient(I_prof, R_arc_prof)\n","    d2IdR2 = np.gradient(dIdR,   R_arc_prof)\n","\n","    # curvature window used for shoulders\n","    R_min_win, R_max_win = 20.0, 80.0\n","    w = (R_arc_prof >= R_min_win) & (R_arc_prof <= R_max_win)\n","\n","    if np.any(w):\n","        idx_min    = np.argmin(d2IdR2[w])\n","        R_sh_shift = float(R_arc_prof[w][idx_min])\n","        K_vals     = d2IdR2[w]\n","        K_min      = float(np.min(K_vals))\n","        K_rms      = float(np.sqrt(np.mean(K_vals**2)))\n","        SNR        = np.abs(K_min) / K_rms if K_rms > 0 else np.nan\n","\n","        print(f\"Most negative curvature in 20–80\\\" window at R ≈ {R_sh_shift:.1f} arcsec\")\n","        print(f\"K_min = {K_min:.3e},  K_rms = {K_rms:.3e},  SNR = {SNR:.2f}\")\n","    else:\n","        R_sh_shift = None\n","        K_min = K_rms = SNR = np.nan\n","        print(\"No valid bins in 20–80\\\" window; cannot define curvature minimum.\")\n","\n","    # -----------------------------------------------------------------\n","    # 4. Plot the cropped image with rings\n","    # -----------------------------------------------------------------\n","    fig, ax = plt.subplots(figsize=(6, 6))\n","    v1, v2 = np.nanpercentile(sub, [5, 99.5])\n","    ax.imshow(sub, origin=\"lower\", vmin=v1, vmax=v2, cmap=\"gray\")\n","    ax.set_title(\n","        f\"Abell 2744 HFF Parallel Field (F814W)\\n\"\n","        f\"shifted centre dx={dx}, dy={dy}\"\n","    )\n","    ax.set_xlabel(\"Pixel X (cropped)\")\n","    ax.set_ylabel(\"Pixel Y (cropped)\")\n","\n","    # radii in pixels for rings (in subimage coordinates)\n","    R_in_pix  = 20.0 / pix_scale\n","    R_out_pix = 80.0 / pix_scale\n","\n","    for r_pix, col in [\n","        (R_in_pix,  \"cyan\"),\n","        (R_out_pix, \"cyan\"),\n","    ]:\n","        circ = Circle(\n","            (x0_sub, y0_sub),\n","            r_pix,\n","            edgecolor=col,\n","            facecolor=\"none\",\n","            linestyle=\"--\",\n","            linewidth=1.5,\n","            alpha=0.8,\n","        )\n","        ax.add_patch(circ)\n","\n","    if R_sh_shift is not None:\n","        R_sh_pix = R_sh_shift / pix_scale\n","        circ = Circle(\n","            (x0_sub, y0_sub),\n","            R_sh_pix,\n","            edgecolor=\"red\",\n","            facecolor=\"none\",\n","            linestyle=\"--\",\n","            linewidth=1.5,\n","            alpha=0.9,\n","            label=fr\"min $d^2I/dR^2$ at {R_sh_shift:.1f}''\",\n","        )\n","        ax.add_patch(circ)\n","        ax.legend(loc=\"lower right\", fontsize=7)\n","\n","    # crosshair\n","    ax.axhline(y0_sub, color=\"yellow\", alpha=0.4, linewidth=0.7)\n","    ax.axvline(x0_sub, color=\"yellow\", alpha=0.4, linewidth=0.7)\n","\n","    plt.tight_layout()\n","    plt.show()\n"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":676},"id":"zfroTOXh4B2D","executionInfo":{"status":"ok","timestamp":1765296645645,"user_tz":0,"elapsed":50433,"user":{"displayName":"Jon Axworthy","userId":"03410905867559825123"}},"outputId":"b9a280ed-6293-4880-90a1-b2ae7169de16"},"execution_count":54,"outputs":[{"output_type":"stream","name":"stdout","text":["Image size: 10800 x 10800 px, pixel scale = 0.0300 arcsec/px\n","Shifted centre: x0=5399.5, y0=5399.5  (dx=0, dy=0)\n","Most negative curvature in 20–80\" window at R ≈ 43.5 arcsec\n","K_min = -2.171e-04,  K_rms = 6.381e-05,  SNR = 3.40\n"]},{"output_type":"display_data","data":{"text/plain":["<Figure size 600x600 with 1 Axes>"],"image/png":"\n"},"metadata":{}}]},{"cell_type":"code","source":["# Cell: ABELL 2744 parallel field — random-centre null test (aligned with κ pipeline)\n","\n","import numpy as np\n","import pandas as pd\n","import matplotlib.pyplot as plt\n","from astropy.io import fits\n","\n","# Parallel-field image (Abell 2744 F814W)\n","NULL_PATH = (\n","    \"/content/drive/MyDrive/grtt/grtt_source_data/stronglensing/\"\n","    \"hlsp_frontier_hst_acs-30mas_abell2744-hffpar_f814w_v1.0_drz.fits\"\n",")\n","\n","# We reuse the same pixel-scale helper as in the main κ pipeline:\n","# pixel_scale_arcsec_from_header(hdr) is already defined above via pixel_scale_arcsec()\n","# If not, uncomment this definition:\n","\n","# def pixel_scale_arcsec_from_header(hdr):\n","#     if \"CD1_1\" in hdr and \"CD2_2\" in hdr:\n","#         sx = np.abs(hdr[\"CD1_1\"]) * 3600.0\n","#         sy = np.abs(hdr[\"CD2_2\"]) * 3600.0\n","#     elif \"CDELT1\" in hdr and \"CDELT2\" in hdr:\n","#         sx = np.abs(hdr[\"CDELT1\"]) * 3600.0\n","#         sy = np.abs(hdr[\"CDELT2\"]) * 3600.0\n","#     else:\n","#         raise RuntimeError(\"No CD/CDELT keys found for pixel scale.\")\n","#     return 0.5 * (sx + sy)\n","\n","def compute_Rsh_null(\n","    img,\n","    pix_scale,\n","    x0,\n","    y0,\n","    R_min=ANG_R_INNER,          # same inner radius as κ pipeline\n","    R_max=ANG_R_OUTER,          # same outer radius as κ pipeline\n","    N_bins=N_BINS,              # same number of bins\n","    R_min_win=SHOULDER_RMIN,    # same shoulder window\n","    R_max_win=SHOULDER_RMAX,\n","):\n","    \"\"\"\n","    Compute the intensity-curvature 'shoulder' radius for a given centre (x0, y0).\n","    The binning and search window are matched to the κ analysis.\n","    Returns R_sh_null in arcsec, or np.nan if not found.\n","    \"\"\"\n","    ny, nx = img.shape\n","    y_idx, x_idx = np.indices(img.shape)\n","    r_pix = np.sqrt((x_idx - x0)**2 + (y_idx - y0)**2)\n","    r_arc = r_pix * pix_scale\n","\n","    valid = np.isfinite(img) & np.isfinite(r_arc)\n","    r_arc_valid = r_arc[valid].ravel()\n","    I_valid     = img[valid].ravel()\n","\n","    bins    = np.linspace(R_min, R_max, N_bins + 1)\n","    centres = 0.5 * (bins[:-1] + bins[1:])\n","\n","    I_mean  = np.zeros(N_bins)\n","    counts  = np.zeros(N_bins, dtype=int)\n","    for i in range(N_bins):\n","        m = (r_arc_valid >= bins[i]) & (r_arc_valid < bins[i+1])\n","        if np.any(m):\n","            vals = I_valid[m]\n","            I_mean[i] = np.mean(vals)\n","            counts[i] = m.sum()\n","        else:\n","            I_mean[i] = np.nan\n","\n","    mask_prof   = (counts > 0) & np.isfinite(I_mean)\n","    R_arc_prof  = centres[mask_prof]\n","    I_prof      = I_mean[mask_prof]\n","\n","    if len(R_arc_prof) < 3:\n","        return np.nan\n","\n","    order       = np.argsort(R_arc_prof)\n","    R_arc_prof  = R_arc_prof[order]\n","    I_prof      = I_prof[order]\n","\n","    dIdR   = np.gradient(I_prof, R_arc_prof)\n","    d2IdR2 = np.gradient(dIdR,   R_arc_prof)\n","\n","    w = (R_arc_prof >= R_min_win) & (R_arc_prof <= R_max_win)\n","    if not np.any(w):\n","        return np.nan\n","\n","    idx_min = np.argmin(d2IdR2[w])\n","    return float(R_arc_prof[w][idx_min])\n","\n","# --- load image once ---\n","with fits.open(NULL_PATH) as hdul:\n","    img = hdul[0].data.astype(float)\n","    hdr = hdul[0].header\n","\n","ny, nx   = img.shape\n","pix_scale = pixel_scale_arcsec(hdr) # arcsec / pixel\n","\n","print(f\"Parallel-field image: {nx} x {ny} px, pixel scale = {pix_scale:.4f} arcsec/px\")\n","\n","# Fiducial centre: image centre (arbitrary for null)\n","x0_c = (nx - 1) / 2.0\n","y0_c = (ny - 1) / 2.0\n","R_sh_centre = compute_Rsh_null(img, pix_scale, x0_c, y0_c)\n","\n","# Random centres inside a safe margin\n","rng = np.random.default_rng(42)\n","N_rand = 100\n","margin = int(ANG_R_OUTER / pix_scale) + 10  # ensure full radial window stays inside\n","\n","xs = rng.integers(margin, nx - margin, size=N_rand)\n","ys = rng.integers(margin, ny - margin, size=N_rand)\n","\n","rows = []\n","for x0, y0 in zip(xs, ys):\n","    R_sh = compute_Rsh_null(img, pix_scale, x0, y0)\n","    rows.append(dict(x0=x0, y0=y0, R_sh_arcsec=R_sh))\n","\n","df_rand = pd.DataFrame(rows)\n","\n","print(f\"\\nFiducial (image-centre) R_sh_null: {R_sh_centre:.2f}\\\"\")\n","print(\"Random-centre nulls: basic stats (ignoring NaN):\")\n","print(df_rand[\"R_sh_arcsec\"].describe())\n","\n","# simple histogram of null R_sh\n","plt.figure(figsize=(5, 4))\n","plt.hist(df_rand[\"R_sh_arcsec\"].dropna(), bins=10, alpha=0.7)\n","plt.xlabel(r\"$R_{\\rm sh}^{\\rm null}$ (arcsec)\")\n","plt.ylabel(\"Count\")\n","plt.title(\"Parallel-field random-centre $R_{\\\\rm sh}$ distribution\")\n","plt.tight_layout()\n","plt.show()\n","\n","df_rand.to_csv(\"A2744_parallel_random_centres_Rsh.csv\", index=False)\n","df_rand.head()\n"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":821},"id":"zg_04UZR8EvB","executionInfo":{"status":"ok","timestamp":1765307792530,"user_tz":0,"elapsed":1664347,"user":{"displayName":"Jon Axworthy","userId":"03410905867559825123"}},"outputId":"e7